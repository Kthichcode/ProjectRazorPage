<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhân viên | Mường Thanh Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --blue:       #0066CC;
            --blue-dark:  #004FA3;
            --blue-dim:   #E8F0FE;
            --blue-mid:   #D0E4FF;
            --divider:    #D2D2D7;
            --bg:         #FFFFFF;
            --bg-alt:     #F5F5F7;
            --text:       #1D1D1F;
            --text-sub:   #6E6E73;
            --sidebar-w:  240px;
            --topbar-h:   56px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-alt);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        /* ── SIDEBAR ── */
        .staff-sidebar {
            position: fixed;
            left: 0; top: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--bg);
            border-right: 1px solid var(--divider);
            display: flex;
            flex-direction: column;
            z-index: 200;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 0 1.4rem;
            border-bottom: 1px solid var(--divider);
            text-decoration: none;
        }
        .sidebar-brand-icon {
            width: 30px; height: 30px;
            background: var(--blue);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: .85rem;
            flex-shrink: 0;
        }
        .sidebar-brand-txt {
            font-size: .88rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
        }
        .sidebar-brand-role {
            font-size: .67rem;
            color: var(--blue);
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 1rem 0;
        }
        .sidebar-section {
            font-size: .63rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-sub);
            padding: .9rem 1.4rem .35rem;
            opacity: .7;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .6rem 1.4rem;
            color: var(--text-sub);
            text-decoration: none;
            font-size: .845rem;
            font-weight: 500;
            border-radius: 0;
            transition: color .15s, background .15s;
            position: relative;
        }
        .sidebar-link::before {
            content: '';
            position: absolute;
            left: 0; top: 20%; bottom: 20%;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: var(--blue);
            opacity: 0;
            transition: opacity .15s;
        }
        .sidebar-link:hover {
            color: var(--text);
            background: var(--bg-alt);
        }
        .sidebar-link.active {
            color: var(--blue);
            background: var(--blue-dim);
            font-weight: 600;
        }
        .sidebar-link.active::before { opacity: 1; }
        .sidebar-link i { width: 18px; text-align: center; font-size: .85rem; }

        .sidebar-footer {
            padding: 1rem 1.4rem;
            border-top: 1px solid var(--divider);
        }
        .btn-sidebar-logout {
            display: flex; align-items: center; gap: .6rem;
            width: 100%; padding: .55rem 1rem;
            background: none; border: 1px solid var(--divider);
            border-radius: 8px; color: var(--text-sub);
            font-size: .82rem; font-weight: 500;
            cursor: pointer; transition: all .2s;
        }
        .btn-sidebar-logout:hover {
            border-color: #C0392B;
            color: #C0392B;
            background: #FFF5F5;
        }

        /* ── TOPBAR ── */
        .staff-topbar {
            position: fixed;
            left: var(--sidebar-w);
            top: 0; right: 0;
            height: var(--topbar-h);
            background: var(--bg);
            border-bottom: 1px solid var(--divider);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            z-index: 100;
        }
        .topbar-title {
            font-size: .92rem;
            font-weight: 600;
            color: var(--text);
        }
        .topbar-right { display: flex; align-items: center; gap: .75rem; }
        .topbar-avatar {
            width: 32px; height: 32px;
            background: var(--blue);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
        }
        .topbar-name {
            font-size: .845rem;
            font-weight: 600;
            color: var(--text);
        }

        /* ── MAIN ── */
        .staff-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 2rem 2.2rem;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── ALERTS ── */
        .staff-alert {
            display: flex; align-items: center; gap: .75rem;
            padding: .85rem 1.2rem;
            border-radius: 10px;
            font-size: .855rem;
            font-weight: 500;
            margin-bottom: 1.4rem;
        }
        .staff-alert-success {
            background: #EBF8F2;
            border: 1px solid #A7EBC7;
            color: #1A6640;
        }
        .staff-alert-danger {
            background: #FEF2F2;
            border: 1px solid #FCA5A5;
            color: #991B1B;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .staff-sidebar { transform: translateX(-100%); }
            .staff-sidebar.open { transform: translateX(0); }
            .staff-topbar, .staff-main { left: 0; margin-left: 0; }
        }

        @RenderSection("StaffStyles", required: false)
    </style>
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="staff-sidebar" id="staffSidebar">
        <a class="sidebar-brand" asp-page="/Staff/RoomDashboard">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-user-gear"></i>
            </div>
            <div>
                <div class="sidebar-brand-txt">Mường Thanh</div>
                <div class="sidebar-brand-role">Nhân viên</div>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section">Vận hành</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("RoomDashboard") == true ? "active" : "")"
               asp-page="/Staff/RoomDashboard">
                <i class="fa-solid fa-table-cells-large"></i> Sơ đồ phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Bookings") == true ? "active" : "")"
               asp-page="/Staff/Bookings">
                <i class="fa-solid fa-calendar-check"></i> Đặt phòng
            </a>

            <div class="sidebar-section">Hệ thống</div>
            <a class="sidebar-link" asp-page="/Index">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-page="/Account/Logout" method="post" class="m-0">
                <button type="submit" class="btn-sidebar-logout">
                    <i class="fa-solid fa-right-from-bracket"></i>Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- TOPBAR -->
    <header class="staff-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="d-lg-none btn border-0 p-1"
                    onclick="document.getElementById('staffSidebar').classList.toggle('open')">
                <i class="fa-solid fa-bars" style="color:var(--blue);"></i>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>
        </div>
        <div class="topbar-right">
            <div class="topbar-avatar">
                @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "S")
            </div>
            <span class="topbar-name d-none d-sm-inline">@User.Identity?.Name</span>
        </div>
    </header>

    <!-- MAIN -->
    <main class="staff-main">
        @RenderBody()
    </main>

    <!-- Toast Container for Notifications -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
        <div id="paymentToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="fa-solid fa-circle-check me-2"></i>
                <strong class="me-auto">Thanh toán thành công</strong>
                <small id="toastTime">Vừa xong</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastMessage">
                Khách hàng vừa thanh toán thành công.
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    
    <script>
        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/roomHub")
            .withAutomaticReconnect()
            .build();

        notificationConnection.on("ReceivePaymentSuccess", function (bookingId, customerName, amount, time) {
            const toastEl = document.getElementById('paymentToast');
            const toastMessage = document.getElementById('toastMessage');
            const toastTime = document.getElementById('toastTime');
            
            toastMessage.innerHTML = `<strong>${customerName}</strong> đã thanh toán thành công đơn đặt phòng <strong>#${bookingId}</strong> số tiền <strong>${amount.toLocaleString('vi-VN')}₫</strong>.`;
            toastTime.innerText = time;
            
            const toast = new bootstrap.Toast(toastEl, { delay: 10000 });
            toast.show();

            // Play a subtle notification sound if possible
            try {
                const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
                audio.play();
            } catch (e) { console.log("Audio play blocked"); }
        });

        notificationConnection.start().catch(err => console.error(err.toString()));
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
