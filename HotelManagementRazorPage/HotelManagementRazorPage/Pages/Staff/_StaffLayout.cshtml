<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhân viên | Mường Thanh Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary:   #0D7055;
            --primary-d: #085C44;
            --primary-l: #0F8A68;
            --accent:    #34D399;
            --sidebar-w: 256px;
            --sidebar-bg:#093D2E;
            --sidebar-txt:rgba(255,255,255,.72);
            --sidebar-hover:#0D7055;
            --topbar-h:  64px;
            --white:     #FFFFFF;
            --gray-50:   #F0FAF6;
            --gray-100:  #D1FAE5;
            --gray-200:  #A7F3D0;
            --text:      #1E293B;
            --text-sub:  #64748B;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: #F0F5F2; color: var(--text); }

        /* ── SIDEBAR ── */
        .admin-sidebar {
            position: fixed;
            left: 0; top: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: transform .3s;
        }
        .sidebar-brand {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            text-decoration: none;
        }
        .sidebar-brand-txt {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--white);
            line-height: 1.2;
        }
        .sidebar-brand-sub {
            font-size: .68rem;
            color: var(--accent);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav { flex: 1; overflow-y: auto; padding: 1.2rem 0; }
        .sidebar-section-label {
            font-size: .63rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            padding: .9rem 1.5rem .4rem;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 1.5rem;
            color: var(--sidebar-txt);
            text-decoration: none;
            font-size: .875rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }
        .sidebar-link:hover {
            background: rgba(255,255,255,.07);
            color: var(--white);
            border-left-color: var(--accent);
        }
        .sidebar-link.active {
            background: rgba(13,112,85,.4);
            color: var(--white);
            border-left-color: var(--accent);
        }
        .sidebar-link i { width: 18px; text-align: center; font-size: .9rem; }

        .sidebar-footer {
            padding: 1.2rem 1.5rem;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        /* ── TOPBAR ── */
        .admin-topbar {
            position: fixed;
            left: var(--sidebar-w);
            top: 0;
            right: 0;
            height: var(--topbar-h);
            background: var(--white);
            border-bottom: 1px solid #D1FAE5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            z-index: 99;
            box-shadow: 0 2px 8px rgba(13,112,85,.06);
        }
        .topbar-title { font-weight: 600; font-size: 1rem; color: var(--text); }
        .topbar-user { display: flex; align-items: center; gap: .8rem; }
        .topbar-avatar {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: var(--white);
            font-size: .85rem;
            font-weight: 700;
        }
        .topbar-username { font-size: .875rem; font-weight: 600; color: var(--primary); }
        .btn-topbar-logout {
            background: none;
            border: 1.5px solid #CBD5E1;
            color: var(--text-sub);
            border-radius: 8px;
            padding: .35rem .9rem;
            font-size: .8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s;
        }
        .btn-topbar-logout:hover { border-color: #EF4444; color: #EF4444; }

        /* ── MAIN CONTENT ── */
        .admin-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 2rem;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.open { transform: translateX(0); }
            .admin-topbar, .admin-main { left: 0; margin-left: 0; }
        }

        @RenderSection("StaffStyles", required: false)
    </style>
</head>
<body>

    <!-- ── SIDEBAR ── -->
    <aside class="admin-sidebar" id="adminSidebar">
        <a class="sidebar-brand" asp-page="/Staff/RoomDashboard">
            <div class="me-3">
                <i class="fa-solid fa-user-gear" style="color:var(--accent);font-size:1.4rem;"></i>
            </div>
            <div>
                <div class="sidebar-brand-txt">Mường Thanh</div>
                <div class="sidebar-brand-sub">Nhân viên lễ tân</div>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Vận hành</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("RoomDashboard") == true ? "active" : "")"
               asp-page="/Staff/RoomDashboard">
                <i class="fa-solid fa-table-cells"></i> Sơ đồ phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Bookings") == true ? "active" : "")"
               asp-page="/Staff/Bookings">
                <i class="fa-solid fa-calendar-check"></i> Danh sách đặt phòng
            </a>

            <div class="sidebar-section-label">Hệ thống</div>
            <a class="sidebar-link" asp-page="/Index">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-page="/Account/Logout" method="post" class="m-0">
                <button type="submit" class="btn-topbar-logout w-100" style="border-radius:8px;padding:.5rem;">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- ── TOP BAR ── -->
    <header class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn border-0 d-lg-none p-1" id="sidebarToggle" onclick="document.getElementById('adminSidebar').classList.toggle('open')">
                <i class="fa-solid fa-bars" style="color:var(--primary);"></i>
            </button>
            <div class="topbar-title">@ViewData["Title"]</div>
        </div>
        <div class="topbar-user">
            <div class="topbar-avatar">
                @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "S")
            </div>
            <span class="topbar-username d-none d-sm-block">@User.Identity?.Name</span>
        </div>
    </header>

    <!-- ── MAIN ── -->
    <main class="admin-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
