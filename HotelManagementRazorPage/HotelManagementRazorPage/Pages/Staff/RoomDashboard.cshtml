@page
@model HotelManagementRazorPage.Pages.Staff.RoomDashboardModel
@using BusinessObjects.Enums
@{
    ViewData["Title"] = "Sơ đồ phòng";
    Layout = "/Pages/Staff/_StaffLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color:var(--primary)">Sơ đồ phòng thực tế</h2>
        <p class="text-muted small">Cập nhật trạng thái phòng theo thời gian thực (Live Dashboard)</p>
    </div>
    <div class="d-flex gap-3">
        <div class="stat-mini">
            <span class="dot bg-success"></span>
            <span class="val">@Model.Rooms.Count(r => r.Status == RoomStatus.Available)</span>
            <span class="lab">Trống</span>
        </div>
        <div class="stat-mini">
            <span class="dot bg-danger"></span>
            <span class="val">@Model.Rooms.Count(r => r.Status == RoomStatus.Occupied)</span>
            <span class="lab">Đang ở</span>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="admin-alert admin-alert-success fade show">
        <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="admin-alert admin-alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="row g-3">
    @foreach (var room in Model.Rooms)
    {
        var activeBooking = Model.GetActiveBooking(room.Id);
        bool isOccupied = room.Status == RoomStatus.Occupied;
        var firstImage = room.RoomImages?.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=2070&auto=format&fit=crop";

        string statusColor = room.Status switch
        {
            RoomStatus.Available => "#0D7055", 
            RoomStatus.Occupied => "#EF4444", 
            RoomStatus.Cleaning => "#F59E0B",
            _ => "#6B7280"
        };

        <div class="col-6 col-md-4 col-lg-3">
            <div class="room-card" style="--card-color: @statusColor; background-image: url('@firstImage');">
                <div class="room-overlay"></div>
                <div class="room-content">
                    <div class="room-top">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="room-number">@room.RoomNumber</span>
                            <span class="room-badge">@room.RoomType?.Name</span>
                        </div>
                    </div>
                    
                    <div class="room-mid text-center">
                        @if (isOccupied && activeBooking != null)
                        {
                            <div class="guest-info animate__animated animate__fadeIn">
                                <i class="fa-solid fa-user-check mb-2 d-block fs-4 text-white"></i>
                                <div class="guest-name text-white">@activeBooking.Customer?.UserName</div>
                                <div class="time-stay small text-white-50">Ngày trả: @activeBooking.CheckOutDate.ToString("dd/MM")</div>
                            </div>
                        }
                        else
                        {
                            <div class="available-info text-white">
                                <i class="fa-solid fa-door-open mb-2 d-block fs-4 opacity-75"></i>
                                <div class="small fw-bold opacity-100">PHÒNG TRỐNG</div>
                            </div>
                        }
                    </div>

                    <div class="room-bottom">
                        @if (isOccupied && activeBooking != null)
                        {
                            <button class="btn-dashboard-action btn-checkout-style w-100" onclick="confirmCheckOut(@activeBooking.Id, '@room.RoomNumber', '@activeBooking.Customer?.UserName')">
                                <i class="fa-solid fa-person-walking-luggage me-1"></i> CHECK-OUT
                            </button>
                        }
                        else
                        {
                            <button class="btn-dashboard-action btn-checkin-style w-100" onclick="loadRoomBookings(@room.Id, '@room.RoomNumber')">
                                <i class="fa-solid fa-id-card-clip me-1"></i> CHECK-IN
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Danh sách khách đặt (Check-in) -->
<div class="modal fade" id="bookingListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-list-check me-2"></i>Chọn khách nhận phòng - <span id="modalRoomNum">---</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Khách hàng</th>
                                <th>Thời gian</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="bookingTableBody">
                        </tbody>
                    </table>
                </div>
                <div id="noBookingsMsg" class="p-5 text-center d-none">
                    <i class="fa-solid fa-calendar-xmark display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted fw-bold">Không có yêu cầu nhận phòng nào.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Check-out -->
<div class="modal fade" id="checkOutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-circle-info text-primary display-4 mb-3"></i>
                <h5 class="fw-bold mb-1">Xác nhận trả phòng?</h5>
                <p class="text-muted small mb-3">Phòng: <strong id="outRoomNum">---</strong><br/>Khách: <span id="outCustName">---</span></p>
                <form method="post" asp-page-handler="CheckOut">
                    <input type="hidden" name="bookingId" id="outBookingId" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-fill fw-bold" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-primary flex-fill fw-bold">XÁC NHẬN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Check-in Final -->
<div class="modal fade" id="confirmCheckInModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-circle-question text-warning display-4 mb-3"></i>
                <h5 class="fw-bold mb-3">Xác nhận nhận phòng?</h5>
                <form method="post" asp-page-handler="CheckIn">
                    <input type="hidden" name="bookingId" id="finalBookingId" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-fill fw-bold" data-bs-dismiss="modal">HỦY</button>
                        <button type="submit" class="btn btn-success flex-fill fw-bold">XÁC NHẬN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section StaffStyles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        .stat-mini {
            background: #fff; padding: .6rem 1.2rem; border-radius: 12px; border: 1px solid #D1FAE5;
            display: flex; align-items: center; gap: .8rem; box-shadow: 0 2px 6px rgba(13,112,85,.04);
        }
        .stat-mini .dot { width: 10px; height: 10px; border-radius: 50%; }
        .stat-mini .val { font-weight: 700; color: var(--text); font-size: 1.1rem; }
        .stat-mini .lab { font-size: .75rem; color: var(--text-sub); font-weight: 500; }

        .room-card {
            background-size: cover; background-position: center; border-radius: 20px; 
            height: 220px; position: relative; overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 2px solid transparent;
        }
        .room-card:hover { transform: translateY(-8px) scale(1.02); box-shadow: 0 20px 40px rgba(0,0,0,0.2); border-color: var(--card-color); }
        .room-overlay { 
            position: absolute; top:0; left:0; width:100%; height:100%; 
            background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.8));
            backdrop-filter: blur(1px); transition: 0.3s;
        }
        .room-card:hover .room-overlay { background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.9)); backdrop-filter: blur(2px); }

        .room-content { position: relative; z-index: 2; height: 100%; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; }

        .room-number { font-size: 1.8rem; font-weight: 900; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
        .room-badge { font-size: .6rem; padding: .2rem .6rem; border-radius: 20px; background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); color: #fff; font-weight: 700; border: 1px solid rgba(255,255,255,0.3); }

        .room-mid { flex-grow: 1; display: flex; align-items: center; justify-content: center; }
        .guest-name { font-weight: 800; font-size: 1rem; text-shadow: 0 1px 3px rgba(0,0,0,0.8); }

        .btn-dashboard-action {
            border: none; padding: .6rem; border-radius: 12px; font-size: .75rem; font-weight: 900;
            transition: all .2s; backdrop-filter: blur(10px); color: #fff; border: 1px solid rgba(255,255,255,0.3);
        }
        .btn-checkin-style { background: rgba(13, 112, 85, 0.6); }
        .btn-checkin-style:hover { background: rgba(13, 112, 85, 0.9); transform: scale(1.05); }
        .btn-checkout-style { background: rgba(239, 68, 68, 0.6); }
        .btn-checkout-style:hover { background: rgba(239, 68, 68, 0.9); transform: scale(1.05); }

        /* Table inside modal */
        #bookingListModal table th { font-size: .75rem; text-transform: uppercase; letter-spacing: 0.5px; color: #64748B; padding: 1rem .5rem; }
        #bookingListModal table td { padding: 1.2rem .5rem; font-size: .9rem; border-bottom: 1px solid #F1F5F9; }
        .cust-name { font-weight: 700; color: #1E293B; display: block; }
        .cust-phone { color: #64748B; font-size: .8rem; }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        async function loadRoomBookings(roomId, roomNum) {
            document.getElementById('modalRoomNum').innerText = roomNum;
            const tableBody = document.getElementById('bookingTableBody');
            const noMsg = document.getElementById('noBookingsMsg');
            
            tableBody.innerHTML = '<tr><td colspan="3" class="text-center p-5"><div class="spinner-border text-success" role="status"></div></td></tr>';
            noMsg.classList.add('d-none');
            
            var modal = new bootstrap.Modal(document.getElementById('bookingListModal'));
            modal.show();

            try {
                const response = await fetch(`?handler=BookingsByRoom&roomId=${roomId}`);
                const data = await response.json();
                
                tableBody.innerHTML = '';
                if (data.length === 0) {
                    noMsg.classList.remove('d-none');
                    return;
                }

                data.forEach(b => {
                    const row = `
                        <tr>
                            <td class="ps-4">
                                <span class="cust-name">${b.customerName}</span>
                                <span class="cust-phone"><i class="fa-solid fa-phone me-1"></i>${b.phoneNumber}</span>
                            </td>
                            <td>
                                <div class="time-range small">
                                    <span class="d-block text-muted">Từ: ${b.checkIn}</span>
                                    <span class="d-block text-muted">Đến: ${b.checkOut}</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-success btn-sm px-3 fw-bold rounded-pill" onclick="confirmCheckIn(${b.id})">
                                    NHẬN PHÒNG
                                </button>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            } catch (error) {
                tableBody.innerHTML = '<tr><td colspan="3" class="text-center text-danger p-4">Lỗi tải dữ liệu.</td></tr>';
            }
        }

        function confirmCheckIn(bookingId) {
            document.getElementById('finalBookingId').value = bookingId;
            var confirmModal = new bootstrap.Modal(document.getElementById('confirmCheckInModal'));
            confirmModal.show();
        }

        function confirmCheckOut(bookingId, roomNum, custName) {
            document.getElementById('outBookingId').value = bookingId;
            document.getElementById('outRoomNum').innerText = roomNum;
            document.getElementById('outCustName').innerText = custName;
            var modal = new bootstrap.Modal(document.getElementById('checkOutModal'));
            modal.show();
        }

        const connection = new signalR.HubConnectionBuilder().withUrl("/roomHub").withAutomaticReconnect().build();
        connection.on("ReceiveStatusUpdate", () => { setTimeout(() => { location.reload(); }, 1000); });
        connection.start().catch(err => console.error(err.toString()));
    </script>
}
