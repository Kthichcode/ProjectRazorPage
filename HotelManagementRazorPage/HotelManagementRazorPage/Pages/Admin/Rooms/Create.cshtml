@page
@model HotelManagementRazorPage.Pages.Admin.Rooms.CreateModel
@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
}

<div class="page-header">
    <h1><i class="fa-solid fa-plus-circle me-2" style="color:var(--primary)"></i>Thêm phòng mới</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Admin/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-page="/Admin/Rooms/Index">Phòng</a></li>
            <li class="breadcrumb-item active">Thêm mới</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="fa-solid fa-bed me-2"></i>Thông tin phòng</h5>
            </div>
            <div class="admin-card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="admin-form-label">Số phòng <span style="color:#DC2626;">*</span></label>
                            <input asp-for="Input.RoomNumber" class="admin-form-control form-control" placeholder="VD: 101, 202A..." />
                            <span asp-validation-for="Input.RoomNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">Loại phòng <span style="color:#DC2626;">*</span></label>
                            <select asp-for="Input.RoomTypeId" class="admin-form-control form-control form-select" asp-items="Model.RoomTypeList">
                                <option value="">-- Chọn loại phòng --</option>
                            </select>
                            <span asp-validation-for="Input.RoomTypeId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">Sức chứa tối đa (khách) <span style="color:#DC2626;">*</span></label>
                            <input asp-for="Input.MaxOccupancy" type="number" min="1" max="20"
                                   class="admin-form-control form-control" placeholder="VD: 2" />
                            <span asp-validation-for="Input.MaxOccupancy" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="admin-form-label">Trạng thái</label>
                            <select asp-for="Input.Status" class="admin-form-control form-control form-select">
                                <option value="1">Còn trống</option>
                                <option value="2">Bảo trì</option>
                            </select>
                        </div>

                        <!-- ── MULTI IMAGE UPLOAD ── -->
                        <div class="col-12">
                            <label class="admin-form-label">Ảnh phòng <span style="color:#94A3B8;font-weight:400;text-transform:none;letter-spacing:0;">(ảnh đầu tiên sẽ là ảnh đại diện)</span></label>

                            <!-- Drop Zone -->
                            <div id="dropZone"
                                 onclick="document.getElementById('imageFiles').click()"
                                 ondragover="event.preventDefault();this.style.borderColor='var(--primary)';"
                                 ondragleave="this.style.borderColor='#CBD5E1';"
                                 ondrop="handleDrop(event)"
                                 style="width:100%;min-height:160px;border:2px dashed #CBD5E1;border-radius:12px;
                                        display:flex;align-items:center;justify-content:center;flex-direction:column;
                                        background:var(--gray-50);cursor:pointer;transition:border-color .2s;padding:1.5rem;">
                                <i class="fa-solid fa-images fa-2x mb-2" style="color:#94A3B8;"></i>
                                <p style="font-size:.88rem;font-weight:600;color:var(--text-sub);margin:0;">Nhấn hoặc kéo thả ảnh vào đây</p>
                                <p style="font-size:.75rem;color:#94A3B8;margin:.3rem 0 0;">JPG, PNG, WEBP — tối đa 5MB mỗi ảnh — có thể chọn nhiều ảnh</p>
                            </div>
                            <input type="file" id="imageFiles" name="ImageFiles"
                                   accept="image/jpeg,image/png,image/webp,image/gif"
                                   multiple class="d-none"
                                   onchange="previewImages(this.files)" />

                            <!-- Preview Grid -->
                            <div id="previewGrid" class="mt-3" style="display:none;">
                                <div style="font-size:.75rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--text-sub);margin-bottom:.6rem;">
                                    Xem trước ảnh đã chọn
                                </div>
                                <div id="previewList" style="display:flex;flex-wrap:wrap;gap:.6rem;"></div>
                                <div style="margin-top:.5rem;font-size:.75rem;color:#94A3B8;">
                                    <i class="fa-solid fa-info-circle"></i> Ảnh đầu tiên (khung xanh) sẽ là ảnh đại diện
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="admin-form-label">Mô tả phòng</label>
                            <textarea asp-for="Input.Description" class="admin-form-control form-control"
                                      rows="3" placeholder="Mô tả ngắn về phòng..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-admin-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Lưu phòng
                        </button>
                        <a asp-page="/Admin/Rooms/Index" class="btn-admin-sm btn-delete" style="padding:.5rem 1.2rem;font-size:.875rem;">
                            <i class="fa-solid fa-xmark"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let allFiles = new DataTransfer();

        function previewImages(files) {
            for (const file of files) {
                if (file.size > 5 * 1024 * 1024) {
                    alert(`"${file.name}" quá lớn (>5MB), bỏ qua.`);
                    continue;
                }
                allFiles.items.add(file);
            }
            document.getElementById('imageFiles').files = allFiles.files;
            renderPreviews();
        }

        function handleDrop(e) {
            e.preventDefault();
            document.getElementById('dropZone').style.borderColor = '#CBD5E1';
            previewImages(e.dataTransfer.files);
        }

        function renderPreviews() {
            const list = document.getElementById('previewList');
            list.innerHTML = '';
            const files = allFiles.files;
            if (files.length === 0) {
                document.getElementById('previewGrid').style.display = 'none';
                return;
            }
            document.getElementById('previewGrid').style.display = 'block';

            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = e => {
                    const wrap = document.createElement('div');
                    wrap.style.cssText = `position:relative;width:110px;height:82px;border-radius:8px;overflow:hidden;
                        border:2px solid ${idx === 0 ? 'var(--primary)' : '#E2EAF4'};`;

                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.cssText = 'width:100%;height:100%;object-fit:cover;';

                    // "Thumbnail" badge on first
                    if (idx === 0) {
                        const badge = document.createElement('div');
                        badge.innerText = 'Đại diện';
                        badge.style.cssText = `position:absolute;bottom:0;left:0;right:0;
                            background:var(--primary);color:#fff;font-size:.6rem;font-weight:700;
                            text-align:center;padding:.15rem 0;`;
                        wrap.appendChild(badge);
                    }

                    // Remove button
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.innerHTML = '&times;';
                    btn.style.cssText = `position:absolute;top:2px;right:3px;background:rgba(0,0,0,.55);
                        border:none;color:#fff;border-radius:50%;width:18px;height:18px;
                        font-size:.7rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;`;
                    btn.onclick = () => { removeFile(idx); };

                    wrap.appendChild(img);
                    wrap.appendChild(btn);
                    list.appendChild(wrap);
                };
                reader.readAsDataURL(file);
            });
        }

        function removeFile(idx) {
            const dt = new DataTransfer();
            Array.from(allFiles.files).forEach((f, i) => { if (i !== idx) dt.items.add(f); });
            allFiles = dt;
            document.getElementById('imageFiles').files = allFiles.files;
            renderPreviews();
        }
    </script>
}
