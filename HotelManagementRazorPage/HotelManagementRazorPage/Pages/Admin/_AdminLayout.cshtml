<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | Mường Thanh Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary:   #1565C0;
            --primary-d: #0D47A1;
            --primary-l: #1976D2;
            --accent:    #42A5F5;
            --sidebar-w: 256px;
            --sidebar-bg:#0D1B3E;
            --sidebar-txt:rgba(255,255,255,.72);
            --sidebar-hover:#1565C0;
            --topbar-h:  64px;
            --white:     #FFFFFF;
            --gray-50:   #F8FAFF;
            --gray-100:  #EFF4FF;
            --gray-200:  #DBEAFE;
            --text:      #1E293B;
            --text-sub:  #64748B;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: #F0F4F8; color: var(--text); }

        /* ── SIDEBAR ── */
        .admin-sidebar {
            position: fixed;
            left: 0; top: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: transform .3s;
        }
        .sidebar-brand {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            text-decoration: none;
        }
        .sidebar-brand-txt {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--white);
            line-height: 1.2;
        }
        .sidebar-brand-sub {
            font-size: .68rem;
            color: var(--accent);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav { flex: 1; overflow-y: auto; padding: 1.2rem 0; }
        .sidebar-section-label {
            font-size: .63rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            padding: .9rem 1.5rem .4rem;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem 1.5rem;
            color: var(--sidebar-txt);
            text-decoration: none;
            font-size: .875rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all .2s;
        }
        .sidebar-link:hover {
            background: rgba(255,255,255,.07);
            color: var(--white);
            border-left-color: var(--accent);
        }
        .sidebar-link.active {
            background: rgba(21,101,192,.35);
            color: var(--white);
            border-left-color: var(--accent);
        }
        .sidebar-link i { width: 18px; text-align: center; font-size: .9rem; }

        .sidebar-footer {
            padding: 1.2rem 1.5rem;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        /* ── TOPBAR ── */
        .admin-topbar {
            position: fixed;
            left: var(--sidebar-w);
            top: 0;
            right: 0;
            height: var(--topbar-h);
            background: var(--white);
            border-bottom: 1px solid #E2EAF4;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            z-index: 99;
            box-shadow: 0 2px 8px rgba(21,101,192,.06);
        }
        .topbar-title {
            font-weight: 600;
            font-size: 1rem;
            color: var(--text);
        }
        .topbar-user {
            display: flex;
            align-items: center;
            gap: .8rem;
        }
        .topbar-avatar {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: var(--white);
            font-size: .85rem;
            font-weight: 700;
        }
        .topbar-username {
            font-size: .875rem;
            font-weight: 600;
            color: var(--primary);
        }
        .btn-topbar-logout {
            background: none;
            border: 1.5px solid #CBD5E1;
            color: var(--text-sub);
            border-radius: 8px;
            padding: .35rem .9rem;
            font-size: .8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s;
        }
        .btn-topbar-logout:hover { border-color: #EF4444; color: #EF4444; }

        /* ── MAIN CONTENT ── */
        .admin-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 2rem;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── PAGE HEADER ── */
        .page-header {
            margin-bottom: 1.8rem;
        }
        .page-header h1 {
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: .25rem;
        }
        .page-header .breadcrumb {
            font-size: .8rem;
            margin: 0;
        }

        /* ── ADMIN CARD ── */
        .admin-card {
            background: var(--white);
            border-radius: 12px;
            border: 1px solid #E2EAF4;
            box-shadow: 0 2px 8px rgba(21,101,192,.05);
            overflow: hidden;
        }
        .admin-card-header {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid #E2EAF4;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .admin-card-header h5 {
            font-size: .96rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }
        .admin-card-body { padding: 1.5rem; }

        /* ── STAT CARD ── */
        .stat-card {
            background: var(--white);
            border-radius: 14px;
            border: 1px solid #E2EAF4;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(21,101,192,.05);
            position: relative;
            overflow: hidden;
            transition: transform .25s, box-shadow .25s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(21,101,192,.12); }
        .stat-card-icon {
            width: 52px; height: 52px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 1.1rem;
        }
        .stat-card-value {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1;
            margin-bottom: .25rem;
        }
        .stat-card-label {
            font-size: .78rem;
            color: var(--text-sub);
            font-weight: 500;
        }

        /* ── TABLE ── */
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th {
            background: var(--gray-50);
            padding: .75rem 1rem;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--text-sub);
            border-bottom: 1px solid #E2EAF4;
            white-space: nowrap;
        }
        .admin-table td {
            padding: .85rem 1rem;
            font-size: .875rem;
            border-bottom: 1px solid #F1F5F9;
            vertical-align: middle;
        }
        .admin-table tbody tr:hover { background: var(--gray-50); }
        .admin-table tbody tr:last-child td { border-bottom: none; }

        /* ── BUTTONS ── */
        .btn-admin-primary {
            background: var(--primary);
            color: var(--white) !important;
            border: none;
            border-radius: 8px;
            padding: .5rem 1.2rem;
            font-size: .875rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            cursor: pointer;
            transition: all .2s;
        }
        .btn-admin-primary:hover { background: var(--primary-d); transform: translateY(-1px); }

        .btn-admin-sm {
            padding: .3rem .75rem;
            font-size: .78rem;
            border-radius: 6px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            cursor: pointer;
            transition: all .2s;
            border: none;
        }
        .btn-edit { background: #EFF4FF; color: var(--primary); }
        .btn-edit:hover { background: #DBEAFE; }
        .btn-delete { background: #FEF2F2; color: #EF4444; }
        .btn-delete:hover { background: #FEE2E2; }
        .btn-view { background: #F0FDF4; color: #16A34A; }
        .btn-view:hover { background: #DCFCE7; }

        /* ── BADGES ── */
        .status-badge {
            padding: .25rem .75rem;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .3px;
        }
        .badge-pending    { background: #FFF7ED; color: #C2410C; }
        .badge-confirmed  { background: #EFF4FF; color: #1565C0; }
        .badge-checkedin  { background: #F0FDF4; color: #15803D; }
        .badge-completed  { background: #F5F3FF; color: #7C3AED; }
        .badge-cancelled  { background: #FEF2F2; color: #DC2626; }
        .badge-available  { background: #EFF4FF; color: #1565C0; }
        .badge-occupied   { background: #FEF2F2; color: #DC2626; }
        .badge-maintenance{ background: #FFF7ED; color: #C2410C; }

        /* ── FORM STYLES ── */
        .admin-form-label {
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--primary);
            margin-bottom: .4rem;
        }
        .admin-form-control {
            border: 1.5px solid #CBD5E1;
            border-radius: 8px;
            padding: .6rem .9rem;
            font-size: .9rem;
            width: 100%;
            color: var(--text);
            transition: border-color .2s, box-shadow .2s;
        }
        .admin-form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(21,101,192,.1);
            outline: none;
        }
        .text-danger { color: #DC2626 !important; font-size: .78rem; margin-top: .2rem; }

        /* ── ALERT ── */
        .admin-alert {
            border-radius: 10px;
            padding: .8rem 1.1rem;
            font-size: .875rem;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: .6rem;
        }
        .admin-alert-success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #15803D; }
        .admin-alert-danger  { background: #FEF2F2; border: 1px solid #FECACA; color: #DC2626; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.open { transform: translateX(0); }
            .admin-topbar, .admin-main { left: 0; margin-left: 0; }
        }

        @RenderSection("AdminStyles", required: false)
    </style>
</head>
<body>

    <!-- ── SIDEBAR ── -->
    <aside class="admin-sidebar" id="adminSidebar">
        <a class="sidebar-brand" asp-page="/Admin/Index">
            <div class="me-3">
                <i class="fa-solid fa-hotel" style="color:var(--accent);font-size:1.4rem;"></i>
            </div>
            <div>
                <div class="sidebar-brand-txt">Mường Thanh</div>
                <div class="sidebar-brand-sub">Bảng điều hành</div>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Tổng quan</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Index" ? "active" : "")"
               asp-page="/Admin/Index">
                <i class="fa-solid fa-chart-pie"></i> Tổng quan
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Statistics" ? "active" : "")"
               asp-page="/Admin/Statistics">
                <i class="fa-solid fa-chart-line"></i> Thống kê
            </a>

            <div class="sidebar-section-label">Quản lý</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Rooms") == true ? "active" : "")"
               asp-page="/Admin/Rooms/Index">
                <i class="fa-solid fa-bed"></i> Phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/RoomTypes") == true ? "active" : "")"
               asp-page="/Admin/RoomTypes/Index">
                <i class="fa-solid fa-layer-group"></i> Loại phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Bookings") == true ? "active" : "")"
               asp-page="/Admin/Bookings/Index">
                <i class="fa-solid fa-calendar-check"></i> Đặt phòng
            </a>

            <div class="sidebar-section-label">Hệ thống</div>
            <a class="sidebar-link" asp-page="/Index">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-page="/Account/Logout" method="post" class="m-0">
                <button type="submit" class="btn-topbar-logout w-100" style="border-radius:8px;padding:.5rem;">
                    <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- ── TOP BAR ── -->
    <header class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn border-0 d-lg-none p-1" id="sidebarToggle" onclick="document.getElementById('adminSidebar').classList.toggle('open')">
                <i class="fa-solid fa-bars" style="color:var(--primary);"></i>
            </button>
            <div class="topbar-title">@ViewData["Title"]</div>
        </div>
        <div class="topbar-user">
            <div class="topbar-avatar">
                @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "A")
            </div>
            <span class="topbar-username d-none d-sm-block">@User.Identity?.Name</span>
        </div>
    </header>

    <!-- ── MAIN ── -->
    <main class="admin-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
