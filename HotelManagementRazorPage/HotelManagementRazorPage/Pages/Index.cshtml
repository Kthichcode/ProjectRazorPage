@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    :root {
        --primary:   #1565C0;
        --primary-d: #0D47A1;
        --primary-l: #1976D2;
        --accent:    #42A5F5;
        --white:     #FFFFFF;
        --gray-50:   #F8FAFF;
        --gray-100:  #EFF4FF;
        --gray-200:  #DBEAFE;
        --text:      #1E293B;
        --text-sub:  #64748B;
    }

    /* ── HERO ── */
    .hero {
        background: linear-gradient(135deg, var(--primary-d) 0%, var(--primary) 50%, var(--primary-l) 100%);
        min-height: 88vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .hero::after {
        content: '';
        position: absolute;
        right: -100px;
        top: -100px;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
    }

    .hero-content { position: relative; z-index: 2; }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.25);
        color: var(--white);
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: .4rem 1.1rem;
        border-radius: 20px;
        margin-bottom: 1.6rem;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.4rem, 5.5vw, 4.2rem);
        font-weight: 700;
        color: var(--white);
        line-height: 1.15;
        margin-bottom: 1.2rem;
    }
    .hero-title span {
        color: #90CAF9;
    }

    .hero-sub {
        color: rgba(255,255,255,.82);
        font-size: 1.05rem;
        line-height: 1.75;
        max-width: 520px;
        margin-bottom: 2.4rem;
    }

    .btn-hero {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: var(--white);
        color: var(--primary) !important;
        font-weight: 700;
        font-size: .95rem;
        padding: .85rem 2rem;
        border-radius: 10px;
        text-decoration: none;
        transition: all .3s;
        box-shadow: 0 6px 20px rgba(0,0,0,.15);
    }
    .btn-hero:hover {
        background: var(--gray-100);
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(0,0,0,.2);
    }

    .btn-hero-ghost {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(8px);
        border: 1.5px solid rgba(255,255,255,.35);
        color: var(--white) !important;
        font-weight: 600;
        font-size: .95rem;
        padding: .85rem 2rem;
        border-radius: 10px;
        text-decoration: none;
        transition: all .3s;
    }
    .btn-hero-ghost:hover {
        background: rgba(255,255,255,.22);
    }

    .hero-stats {
        display: flex;
        gap: 2.5rem;
        margin-top: 3rem;
        padding-top: 2.2rem;
        border-top: 1px solid rgba(255,255,255,.2);
    }
    .stat-val {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--white);
        line-height: 1;
    }
    .stat-lbl {
        font-size: .75rem;
        color: rgba(255,255,255,.65);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: .3rem;
    }

    /* ── SEARCH CARD ── */
    .search-wrap {
        position: relative;
        z-index: 10;
        margin-top: -56px;
    }

    .search-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(21,101,192,.18);
        padding: 2rem 2.5rem;
    }

    .search-card .form-label {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: .45rem;
    }

    .search-card .form-control,
    .search-card .form-select {
        border: 1.5px solid #CBD5E1;
        border-radius: 8px;
        padding: .65rem .9rem;
        font-size: .9rem;
        color: var(--text);
        transition: border-color .2s, box-shadow .2s;
    }
    .search-card .form-control:focus,
    .search-card .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(21,101,192,.12);
        outline: none;
    }

    .btn-search {
        background: var(--primary);
        color: var(--white);
        font-weight: 700;
        padding: .72rem 1.5rem;
        border-radius: 8px;
        border: none;
        width: 100%;
        font-size: .92rem;
        transition: all .25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }
    .btn-search:hover {
        background: var(--primary-d);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(21,101,192,.3);
    }

    /* ── SECTION HEADER ── */
    .sec-tag {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: .6rem;
    }
    .sec-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 700;
        color: var(--text);
    }
    .sec-line {
        width: 48px;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        border-radius: 2px;
        margin: .9rem auto 0;
    }

    /* ── ROOM CARD ── */
    .room-card {
        background: var(--white);
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #E2EAF4;
        transition: all .35s;
        height: 100%;
        box-shadow: 0 2px 12px rgba(21,101,192,.06);
    }
    .room-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 50px rgba(21,101,192,.14);
        border-color: var(--accent);
    }

    .room-img {
        position: relative;
        height: 210px;
        overflow: hidden;
    }
    .room-img img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform .5s;
    }
    .room-card:hover .room-img img { transform: scale(1.06); }

    .badge-avail {
        position: absolute; top: 12px; left: 12px;
        padding: .25rem .7rem;
        border-radius: 20px;
        font-size: .7rem; font-weight: 700;
        letter-spacing: .5px;
    }
    .badge-avail.yes { background: #1565C0; color: #fff; }
    .badge-avail.no  { background: #EF4444; color: #fff; }

    .room-body { padding: 1.4rem; }

    .room-type-tag {
        font-size: .7rem; font-weight: 700;
        letter-spacing: 2px; text-transform: uppercase;
        color: var(--accent);
        margin-bottom: .35rem;
    }
    .room-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.1rem; font-weight: 700;
        color: var(--text); margin-bottom: .5rem;
    }
    .room-desc {
        font-size: .83rem; color: var(--text-sub);
        line-height: 1.6; margin-bottom: .9rem;
        display: -webkit-box;
        -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .room-meta {
        display: flex; gap: 1rem; align-items: center;
        font-size: .8rem; color: var(--text-sub);
        padding: .9rem 0;
        border-top: 1px solid var(--gray-100);
        border-bottom: 1px solid var(--gray-100);
        margin-bottom: .9rem;
    }
    .room-meta i { color: var(--primary); }

    .room-foot {
        display: flex; align-items: center; justify-content: space-between;
    }
    .room-price-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem; font-weight: 700;
        color: var(--primary);
    }
    .room-price-unit { font-size: .75rem; color: var(--text-sub); }

    .btn-book {
        background: var(--primary);
        color: var(--white) !important;
        font-size: .82rem; font-weight: 600;
        padding: .45rem 1.1rem;
        border-radius: 8px; text-decoration: none;
        transition: all .25s;
        display: inline-flex; align-items: center; gap: .4rem;
    }
    .btn-book:hover { background: var(--primary-d); transform: translateY(-1px); }

    /* ── FEATURES ── */
    .features-section {
        background: var(--gray-50);
        padding: 5.5rem 0;
    }

    .feature-card {
        background: var(--white);
        border: 1px solid #E2EAF4;
        border-radius: 14px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: all .3s;
        height: 100%;
    }
    .feature-card:hover {
        border-color: var(--accent);
        box-shadow: 0 12px 35px rgba(21,101,192,.1);
        transform: translateY(-4px);
    }

    .feature-icon {
        width: 68px; height: 68px;
        background: var(--gray-100);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.2rem;
        font-size: 1.5rem;
        color: var(--primary);
        transition: all .3s;
    }
    .feature-card:hover .feature-icon {
        background: var(--primary);
        color: var(--white);
    }
    .feature-name {
        font-weight: 700; font-size: .96rem;
        color: var(--text); margin-bottom: .4rem;
    }
    .feature-desc { font-size: .82rem; color: var(--text-sub); line-height: 1.6; }

    /* ── CTA ── */
    .cta-section {
        background: linear-gradient(135deg, var(--primary-d), var(--primary));
        padding: 5rem 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-section::before {
        content: '';
        position: absolute; inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .cta-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 3.5vw, 2.8rem);
        color: var(--white); font-weight: 700;
        margin-bottom: .9rem; position: relative;
    }
    .cta-sub { color: rgba(255,255,255,.78); font-size: 1rem; margin-bottom: 2rem; position: relative; }

    /* ── EMPTY ── */
    .empty-state {
        text-align: center; padding: 4rem 1rem; color: var(--text-sub);
    }
    .empty-state i { font-size: 3rem; color: var(--gray-200); display: block; margin-bottom: 1rem; }
</style>

<!-- ═══ HERO ═══ -->
<section class="hero">
    <div class="container hero-content">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-tag">
                    <i class="fa-solid fa-star"></i> Khách sạn 5 sao hàng đầu Việt Nam
                </div>
                <h1 class="hero-title">
                    Nghỉ dưỡng sang trọng<br>tại <span>Mường Thanh Hotel</span>
                </h1>
                <p class="hero-sub">
                    Hệ thống khách sạn hàng đầu Việt Nam với hơn 50 phòng cao cấp,
                    mang đến trải nghiệm lưu trú đẳng cấp, ấm cúng và khó quên.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#rooms" class="btn-hero">
                        <i class="fa-solid fa-bed"></i>Xem phòng ngay
                    </a>
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a asp-page="/Account/Register" class="btn-hero-ghost">
                            <i class="fa-solid fa-user-plus"></i>Đăng ký tài khoản
                        </a>
                    }
                </div>
                <div class="hero-stats">
                    <div>
                        <div class="stat-val">50+</div>
                        <div class="stat-lbl">Phòng cao cấp</div>
                    </div>
                    <div>
                        <div class="stat-val">5★</div>
                        <div class="stat-lbl">Xếp hạng</div>
                    </div>
                    <div>
                        <div class="stat-val">10k+</div>
                        <div class="stat-lbl">Lượt khách</div>
                    </div>
                    <div>
                        <div class="stat-val">24/7</div>
                        <div class="stat-lbl">Hỗ trợ</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ═══ ROOMS ═══ -->
<section id="rooms" class="py-5" style="background:var(--white);">
    <div class="container">
        <div class="text-center mb-5">
            <p class="sec-tag">Danh sách phòng</p>
            <h2 class="sec-title">
                @(Model.IsSearching ? "Kết quả tìm kiếm" : "Phòng nổi bật")
            </h2>
            <div class="sec-line"></div>
        </div>

        @if (!Model.Rooms.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-bed"></i>
                <p>Không tìm thấy phòng phù hợp.<br>Vui lòng thử lại với điều kiện khác.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-img">
                                @{
                                    var fallback = "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80";
                                }
                                <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? fallback : room.ImageUrl)"
                                     alt="Phòng @room.RoomNumber" />
                                @{
                                    bool avail = room.Status == BusinessObjects.Enums.RoomStatus.Available;
                                }
                                <span class="badge-avail @(avail ? "yes" : "no")">
                                    <i class="fa-solid @(avail ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                                    @(avail ? "Còn phòng" : "Đã đặt")
                                </span>
                            </div>
                            <div class="room-body">
                                <div class="room-type-tag">@(room.RoomType?.Name ?? "Phòng")</div>
                                <div class="room-name">Phòng @room.RoomNumber</div>
                                <div class="room-desc">
                                    @(string.IsNullOrEmpty(room.Description)
                                        ? "Phòng tiện nghi đầy đủ, thiết kế hiện đại mang lại sự thoải mái tuyệt vời."
                                        : room.Description)
                                </div>
                                <div class="room-meta">
                                    <span><i class="fa-solid fa-users me-1"></i>@room.MaxOccupancy khách</span>
                                    @if (room.RoomType != null)
                                    {
                                        <span><i class="fa-solid fa-layer-group me-1"></i>@room.RoomType.Name</span>
                                    }
                                </div>
                                <div class="room-foot">
                                    <div>
                                        <div class="room-price-num">
                                            @((room.RoomType?.PricePerNight ?? 0).ToString("N0"))₫
                                        </div>
                                        <div class="room-price-unit">/ đêm</div>
                                    </div>
                                    <div style="display:flex;gap:.4rem;">
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id"
                                           class="btn-book" style="background:var(--white);color:var(--primary)!important;border:1.5px solid var(--primary);">
                                            <i class="fa-solid fa-eye"></i>Chi tiết
                                        </a>
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id" class="btn-book">
                                            <i class="fa-solid fa-calendar-check"></i>Đặt phòng
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ═══ FEATURES ═══ -->
<section class="features-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="sec-tag">Tiện ích & Dịch vụ</p>
            <h2 class="sec-title">Trải nghiệm đẳng cấp</h2>
            <div class="sec-line"></div>
        </div>
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-wifi"></i></div>
                    <div class="feature-name">WiFi tốc độ cao</div>
                    <div class="feature-desc">Kết nối không giới hạn 24/7 trên toàn khuôn viên</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div class="feature-name">Nhà hàng 5 sao</div>
                    <div class="feature-desc">Ẩm thực đa dạng từ truyền thống đến quốc tế</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-person-swimming"></i></div>
                    <div class="feature-name">Hồ bơi vô cực</div>
                    <div class="feature-desc">View toàn cảnh thành phố tuyệt đẹp</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-spa"></i></div>
                    <div class="feature-name">Spa & Wellness</div>
                    <div class="feature-desc">Liệu pháp thư giãn và chăm sóc sức khỏe</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-car"></i></div>
                    <div class="feature-name">Đưa đón sân bay</div>
                    <div class="feature-desc">Dịch vụ limousine cao cấp 24/7</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-dumbbell"></i></div>
                    <div class="feature-name">Phòng gym</div>
                    <div class="feature-desc">Trang thiết bị hiện đại, huấn luyện viên riêng</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-mug-hot"></i></div>
                    <div class="feature-name">Phòng hội nghị</div>
                    <div class="feature-desc">Không gian hiện đại cho sự kiện doanh nghiệp</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="feature-name">An ninh 24/7</div>
                    <div class="feature-desc">Hệ thống bảo vệ và an toàn tuyệt đối</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CTA ═══ -->
@if (!User.Identity!.IsAuthenticated)
{
    <section class="cta-section">
        <div class="container position-relative">
            <h2 class="cta-title">Đặt phòng ngay hôm nay!</h2>
            <p class="cta-sub">Đăng ký tài khoản để nhận ưu đãi thành viên và trải nghiệm dịch vụ đặt phòng nhanh chóng.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-page="/Account/Register" class="btn-hero">
                    <i class="fa-solid fa-user-plus"></i>Đăng ký miễn phí
                </a>
                <a asp-page="/Account/Login" class="btn-hero-ghost">
                    <i class="fa-solid fa-right-to-bracket"></i>Đăng nhập
                </a>
            </div>
        </div>
    </section>
}
