@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* ── RESET & TOKENS ── */
    :root {
        --blue:      #0066CC;
        --blue-dark: #004FA3;
        --blue-dim:  #E8F0FE;
        --blue-mid:  #D0E4FF;
        --text:      #1D1D1F;
        --text-sub:  #6E6E73;
        --divider:   #D2D2D7;
        --bg:        #FFFFFF;
        --bg-alt:    #F5F5F7;
    }

    /* ── HERO ── */
    .hero-apple {
        background: var(--bg);
        padding: 140px 0 100px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-apple::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,102,204,.08) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-eyebrow {
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 1.1rem;
    }

    .hero-headline {
        font-family: 'Playfair Display', serif;
        font-size: clamp(3rem, 7vw, 5.6rem);
        font-weight: 700;
        color: var(--text);
        line-height: 1.08;
        letter-spacing: -1.5px;
        margin-bottom: 1.2rem;
    }

    .hero-sub {
        font-size: clamp(1rem, 2.2vw, 1.25rem);
        color: var(--text-sub);
        font-weight: 400;
        max-width: 560px;
        margin: 0 auto 2.4rem;
        line-height: 1.65;
    }

    .hero-cta-group {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-apple-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: var(--blue);
        color: #fff !important;
        text-decoration: none;
        font-size: .92rem;
        font-weight: 600;
        padding: .75rem 1.8rem;
        border-radius: 980px;
        transition: background .2s, transform .2s;
        letter-spacing: -.2px;
    }
    .btn-apple-primary:hover {
        background: var(--blue-dark);
        transform: scale(1.02);
    }

    .btn-apple-ghost {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: transparent;
        color: var(--blue) !important;
        text-decoration: none;
        font-size: .92rem;
        font-weight: 600;
        padding: .75rem 1.8rem;
        border-radius: 980px;
        border: 1.5px solid var(--blue);
        transition: all .2s;
        letter-spacing: -.2px;
    }
    .btn-apple-ghost:hover {
        background: var(--blue);
        color: #fff !important;
        transform: scale(1.02);
    }

    /* ── STATS BAR ── */
    .stats-bar {
        background: var(--bg-alt);
        border-top: 1px solid var(--divider);
        border-bottom: 1px solid var(--divider);
        padding: 2.2rem 0;
    }
    .stats-bar .row { text-align: center; }
    .stat-num {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 700;
        color: var(--blue);
        line-height: 1;
    }
    .stat-label {
        font-size: .78rem;
        color: var(--text-sub);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-top: .35rem;
    }

    /* ── SECTION CHROME ── */
    .section-label {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: .6rem;
    }
    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 3.5vw, 2.6rem);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.5px;
        line-height: 1.15;
    }

    /* ── ROOMS SECTION ── */
    .rooms-section {
        padding: 100px 0 80px;
        background: var(--bg);
    }

    .room-card-apple {
        background: var(--bg);
        border: 1px solid var(--divider);
        border-radius: 18px;
        overflow: hidden;
        transition: box-shadow .3s, transform .3s;
        height: 100%;
    }
    .room-card-apple:hover {
        box-shadow: 0 20px 60px rgba(0,0,0,.1);
        transform: translateY(-4px);
    }

    .room-card-img {
        height: 220px;
        overflow: hidden;
        position: relative;
    }
    .room-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .6s ease;
        display: block;
    }
    .room-card-apple:hover .room-card-img img { transform: scale(1.04); }

    .room-badge {
        position: absolute;
        top: 14px; left: 14px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .5px;
        padding: .28rem .75rem;
        border-radius: 980px;
        background: var(--blue);
        color: #fff;
    }
    .room-badge.unavail { background: #86868B; }

    .room-card-body { padding: 1.5rem 1.4rem 1.4rem; }

    .room-card-type {
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: .4rem;
    }
    .room-card-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: .45rem;
    }
    .room-card-desc {
        font-size: .83rem;
        color: var(--text-sub);
        line-height: 1.6;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .room-card-meta {
        display: flex;
        gap: 1.1rem;
        font-size: .78rem;
        color: var(--text-sub);
        padding: .9rem 0;
        border-top: 1px solid var(--bg-alt);
        border-bottom: 1px solid var(--bg-alt);
        margin-bottom: 1rem;
    }
    .room-card-meta i { color: var(--blue); }

    .room-card-foot { display: flex; align-items: center; justify-content: space-between; }
    .room-price {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text);
    }
    .room-price-unit { font-size: .75rem; color: var(--text-sub); margin-left: .2rem; }

    .room-btn-group { display: flex; gap: .4rem; }
    .btn-room-outline {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .78rem; font-weight: 600; color: var(--blue) !important;
        border: 1.5px solid var(--blue); border-radius: 980px;
        padding: .38rem 1rem; text-decoration: none; transition: all .2s;
    }
    .btn-room-outline:hover { background: var(--blue); color: #fff !important; }

    .btn-room-solid {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .78rem; font-weight: 600; color: #fff !important;
        background: var(--blue); border-radius: 980px;
        padding: .38rem 1rem; text-decoration: none; transition: all .2s;
    }
    .btn-room-solid:hover { background: var(--blue-dark); }

    /* ── EMPTY STATE ── */
    .empty-apple {
        text-align: center;
        padding: 5rem 1rem;
        color: var(--text-sub);
    }
    .empty-apple i { font-size: 2.6rem; color: var(--divider); display: block; margin-bottom: 1rem; }

    /* ── AMENITIES ── */
    .amenities-section {
        background: var(--bg-alt);
        padding: 100px 0;
        border-top: 1px solid var(--divider);
        border-bottom: 1px solid var(--divider);
    }

    .amenity-item {
        text-align: center;
        padding: 2.4rem 1.2rem;
        border-radius: 18px;
        background: var(--bg);
        border: 1px solid var(--divider);
        height: 100%;
        transition: box-shadow .25s, transform .25s;
    }
    .amenity-item:hover {
        box-shadow: 0 12px 40px rgba(0,0,0,.08);
        transform: translateY(-3px);
    }
    .amenity-icon {
        width: 56px; height: 56px;
        border-radius: 14px;
        background: var(--blue-dim);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.1rem;
        font-size: 1.3rem;
        color: var(--blue);
        transition: background .25s, color .25s;
    }
    .amenity-item:hover .amenity-icon {
        background: var(--blue);
        color: #fff;
    }
    .amenity-name {
        font-size: .9rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: .4rem;
    }
    .amenity-desc {
        font-size: .78rem;
        color: var(--text-sub);
        line-height: 1.55;
    }

    /* ── CTA ── */
    .cta-apple {
        background: var(--blue);
        padding: 100px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-apple::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(255,255,255,.06) 0%, transparent 70%);
    }
    .cta-headline {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: #fff;
        letter-spacing: -.5px;
        margin-bottom: .8rem;
        position: relative;
    }
    .cta-sub {
        color: rgba(255,255,255,.75);
        font-size: 1rem;
        margin-bottom: 2.2rem;
        position: relative;
    }
    .btn-cta-white {
        display: inline-flex; align-items: center; gap: .5rem;
        background: #fff; color: var(--blue) !important;
        text-decoration: none; font-size: .92rem; font-weight: 700;
        padding: .8rem 2rem; border-radius: 980px;
        transition: all .2s; position: relative;
    }
    .btn-cta-white:hover { background: var(--blue-dim); transform: scale(1.02); }
    .btn-cta-outline {
        display: inline-flex; align-items: center; gap: .5rem;
        background: transparent; color: #fff !important;
        text-decoration: none; font-size: .92rem; font-weight: 600;
        padding: .8rem 2rem; border-radius: 980px;
        border: 1.5px solid rgba(255,255,255,.5);
        transition: all .2s; position: relative;
    }
    .btn-cta-outline:hover { border-color: #fff; background: rgba(255,255,255,.1); }

    /* ── STAR RATING ── */
    .room-stars { display: flex; align-items: center; gap: .35rem; margin-bottom: .65rem; }
    .star-wrap  { display: flex; gap: 2px; }
    .star-wrap i.filled { color: #F59E0B; font-size: .82rem; }
    .star-wrap i.half   { color: #F59E0B; font-size: .82rem; }
    .star-wrap i.empty  { color: #D2D2D7; font-size: .82rem; }
    .star-avg   { font-size: .78rem; font-weight: 700; color: var(--text); }
    .star-count { font-size: .73rem; color: var(--text-sub); }
    .star-none  { font-size: .73rem; color: var(--text-sub); font-style: italic; }
</style>


<!-- ═══ HERO ═══ -->
<section class="hero-apple">
    <div class="container">
        <p class="hero-eyebrow">Khách sạn 5 sao hàng đầu Việt Nam</p>
        <h1 class="hero-headline">
            Nghỉ dưỡng sang trọng<br>
            <span style="color:var(--blue);">tại Mường Thanh</span>
        </h1>
        <p class="hero-sub">
            Trải nghiệm lưu trú đẳng cấp với hơn 50 phòng cao cấp,
            thiết kế tinh tế và dịch vụ hoàn hảo 24/7.
        </p>
        <div class="hero-cta-group">
            <a href="#rooms" class="btn-apple-primary">
                <i class="fa-solid fa-bed"></i>Xem phòng ngay
            </a>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-page="/Account/Register" class="btn-apple-ghost">
                    <i class="fa-solid fa-user-plus"></i>Đăng ký
                </a>
            }
        </div>
    </div>
</section>

<!-- ═══ STATS ═══ -->
<div class="stats-bar">
    <div class="container">
        <div class="row g-3 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="stat-num">50+</div>
                <div class="stat-label">Phòng cao cấp</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-num">5★</div>
                <div class="stat-label">Xếp hạng</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-num">10k+</div>
                <div class="stat-label">Lượt khách</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-num">24/7</div>
                <div class="stat-label">Hỗ trợ</div>
            </div>
        </div>
    </div>
</div>


<!-- ═══ ROOMS ═══ -->
<section id="rooms" class="rooms-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="section-label">Danh sách phòng</p>
            <h2 class="section-title">
                @(Model.IsSearching ? "Kết quả tìm kiếm" : "Phòng nổi bật")
            </h2>
        </div>

        @if (!Model.Rooms.Any())
        {
            <div class="empty-apple">
                <i class="fa-solid fa-bed"></i>
                <p>Không tìm thấy phòng phù hợp.<br>Vui lòng thử lại với điều kiện khác.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="room-card-apple">
                            <div class="room-card-img">
                                @{
                                    var fallback = "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80";
                                    bool avail = room.Status == BusinessObjects.Enums.RoomStatus.Available;
                                }
                                <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? fallback : room.ImageUrl)"
                                     alt="Phòng @room.RoomNumber" />
                                <span class="room-badge @(avail ? "" : "unavail")">
                                    @(avail ? "Còn phòng" : "Đã đặt")
                                </span>
                            </div>
                            <div class="room-card-body">
                                <div class="room-card-type">@(room.RoomType?.Name ?? "Phòng")</div>
                                <div class="room-card-name">Phòng @room.RoomNumber</div>
                                <div class="room-card-desc">
                                    @(string.IsNullOrEmpty(room.Description)
                                        ? "Phòng tiện nghi đầy đủ, thiết kế hiện đại mang lại sự thoải mái tuyệt vời."
                                        : room.Description)
                                </div>
                                @{
                                    bool hasRating2 = Model.RoomRatings.TryGetValue(room.Id, out var rating2);
                                    double avg2 = hasRating2 ? rating2.Avg : 0;
                                    int rCount2 = hasRating2 ? rating2.Count : 0;
                                }
                                <div class="room-stars">
                                    @if (hasRating2)
                                    {
                                        <div class="star-wrap">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                if (avg2 >= s)
                                                { <i class="fa-solid fa-star filled"></i> }
                                                else if (avg2 >= s - 0.5)
                                                { <i class="fa-solid fa-star-half-stroke half"></i> }
                                                else
                                                { <i class="fa-regular fa-star empty"></i> }
                                            }
                                        </div>
                                        <span class="star-avg">@avg2.ToString("0.0")</span>
                                        <span class="star-count">(@rCount2 đánh giá)</span>
                                    }
                                    else
                                    {
                                        <span class="star-none">Chưa có đánh giá</span>
                                    }
                                </div>
                                <div class="room-card-meta">
                                    <span><i class="fa-solid fa-users me-1"></i>@room.MaxOccupancy khách</span>
                                    @if (room.RoomType != null)
                                    {
                                        <span><i class="fa-solid fa-layer-group me-1"></i>@room.RoomType.Name</span>
                                    }
                                </div>
                                <div class="room-card-foot">
                                    <div>
                                        <span class="room-price">
                                            @((room.RoomType?.PricePerNight ?? 0).ToString("N0"))₫
                                        </span>
                                        <span class="room-price-unit">/ đêm</span>
                                    </div>
                                    <div class="room-btn-group">
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id"
                                           class="btn-room-outline">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id"
                                           class="btn-room-solid">
                                            <i class="fa-solid fa-calendar-check"></i>Đặt phòng
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>


<!-- ═══ AMENITIES ═══ -->
<section class="amenities-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="section-label">Tiện ích &amp; Dịch vụ</p>
            <h2 class="section-title">Mọi thứ bạn cần</h2>
        </div>
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-wifi"></i></div>
                    <div class="amenity-name">WiFi tốc độ cao</div>
                    <div class="amenity-desc">Kết nối không giới hạn 24/7 trên toàn khu</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div class="amenity-name">Nhà hàng 5 sao</div>
                    <div class="amenity-desc">Ẩm thực đa dạng từ truyền thống đến quốc tế</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-person-swimming"></i></div>
                    <div class="amenity-name">Hồ bơi vô cực</div>
                    <div class="amenity-desc">View toàn cảnh thành phố tuyệt đẹp</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-spa"></i></div>
                    <div class="amenity-name">Spa &amp; Wellness</div>
                    <div class="amenity-desc">Liệu pháp thư giãn và chăm sóc sức khỏe</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-car"></i></div>
                    <div class="amenity-name">Đưa đón sân bay</div>
                    <div class="amenity-desc">Dịch vụ limousine cao cấp 24/7</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-dumbbell"></i></div>
                    <div class="amenity-name">Phòng gym</div>
                    <div class="amenity-desc">Trang thiết bị hiện đại, huấn luyện viên riêng</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-mug-hot"></i></div>
                    <div class="amenity-name">Phòng hội nghị</div>
                    <div class="amenity-desc">Không gian hiện đại cho sự kiện doanh nghiệp</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="amenity-item">
                    <div class="amenity-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="amenity-name">An ninh 24/7</div>
                    <div class="amenity-desc">Hệ thống bảo vệ và an toàn tuyệt đối</div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ═══ CTA ═══ -->
@if (!User.Identity!.IsAuthenticated)
{
    <section class="cta-apple">
        <div class="container position-relative">
            <h2 class="cta-headline">Đặt phòng ngay hôm nay.</h2>
            <p class="cta-sub">Đăng ký tài khoản để nhận ưu đãi thành viên và trải nghiệm đặt phòng nhanh chóng.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-page="/Account/Register" class="btn-cta-white">
                    <i class="fa-solid fa-user-plus"></i>Đăng ký miễn phí
                </a>
                <a asp-page="/Account/Login" class="btn-cta-outline">
                    <i class="fa-solid fa-right-to-bracket"></i>Đăng nhập
                </a>
            </div>
        </div>
    </section>
}
