@page
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;">
    <div style="text-align:center;max-width:420px;padding:2rem;">
        <div style="width:80px;height:80px;background:#FEE2E2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
            <i class="fa-solid fa-shield-halved" style="font-size:2rem;color:#EF4444;"></i>
        </div>
        <h2 style="font-family:'Playfair Display',serif;font-weight:700;color:#1E293B;margin-bottom:.75rem;">
            Không có quyền truy cập
        </h2>
        <p style="color:#64748B;font-size:.95rem;line-height:1.7;margin-bottom:2rem;">
            Bạn không có quyền truy cập vào trang này.<br>
            Vui lòng đăng nhập bằng tài khoản phù hợp hoặc quay lại trang chủ.
        </p>
        <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;">
            <a asp-page="/Index"
               style="display:inline-flex;align-items:center;gap:.4rem;background:#1565C0;color:#fff;text-decoration:none;padding:.6rem 1.3rem;border-radius:9px;font-weight:700;font-size:.9rem;transition:background .2s;"
               onmouseover="this.style.background='#0D47A1'" onmouseout="this.style.background='#1565C0'">
                <i class="fa-solid fa-house"></i> Trang chủ
            </a>
            <form asp-page="/Account/Logout" method="post" class="m-0">
                <button type="submit"
                        style="display:inline-flex;align-items:center;gap:.4rem;background:none;border:1.5px solid #CBD5E1;color:#64748B;padding:.6rem 1.3rem;border-radius:9px;font-weight:600;font-size:.9rem;cursor:pointer;transition:all .2s;"
                        onmouseover="this.style.borderColor='#EF4444';this.style.color='#EF4444'" 
                        onmouseout="this.style.borderColor='#CBD5E1';this.style.color='#64748B'">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>
</div>
