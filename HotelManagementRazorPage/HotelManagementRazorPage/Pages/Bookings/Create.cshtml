@page "{roomId:int}"
@model HotelManagementRazorPage.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Đặt phòng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="mb-4 text-center">Xác nhận đặt phòng</h2>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary">Phòng @Model.Room.RoomNumber</h5>
                    <p class="card-text text-muted">@Model.Room.RoomType?.Name</p>
                    <hr />
                    <p class="card-text">
                        <strong>Giá mỗi đêm:</strong> 
                        <span class="text-danger fw-bold">@((Model.Room.RoomType?.PricePerNight ?? 0).ToString("N0"))₫</span>
                    </p>
                    <p class="card-text">
                        <strong>Sức chứa tối đa:</strong> @Model.Room.MaxOccupancy người
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation"></i> @Model.ErrorMessage
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ngày nhận phòng</label>
                                <input type="date" asp-for="CheckIn" class="form-control" 
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required id="checkInDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ngày trả phòng</label>
                                <input type="date" asp-for="CheckOut" class="form-control" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required id="checkOutDate" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Tổng tiền tạm tính:</label>
                            <h4 id="totalAmountDisplay" class="text-primary fw-bold">0₫</h4>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Phương thức thanh toán</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="Cash">Thanh toán tại quầy (Tiền mặt)</option>
                                <option value="VNPay">Thanh toán trực tuyến (VNPay)</option>
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#cancellationPolicyModal">
                                <i class="fa-solid fa-check-circle"></i> Xác nhận đặt phòng
                            </button>
                            <a asp-page="/Rooms/Detail" asp-route-id="@Model.Room.Id" class="btn btn-light">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancellation Policy Modal -->
<div class="modal fade" id="cancellationPolicyModal" tabindex="-1" aria-labelledby="policyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;overflow:hidden;border:none;">
            <div class="modal-header" style="background:linear-gradient(135deg,#1D4ED8,#2563EB);color:#fff;border:none;">
                <h5 class="modal-title fw-bold" id="policyModalLabel">
                    <i class="fa-solid fa-file-contract me-2"></i>Chính sách hủy phòng
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-3">Vui lòng đọc kỹ chính sách hoàn tiền trước khi xác nhận:</p>
                <div class="d-flex gap-3 mb-3 align-items-start p-3" style="background:#D1FAE5;border-radius:10px;">
                    <div style="font-size:1.8rem;">&#x2705;</div>
                    <div>
                        <div class="fw-bold text-success">Hủy trong vòng 24h kể từ khi đặt</div>
                        <div class="text-muted" style="font-size:.9rem;">Bạn được hoàn <strong>100%</strong> số tiền vào ví, sau khi manager duyệt.</div>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3 align-items-start p-3" style="background:#FEF3C7;border-radius:10px;">
                    <div style="font-size:1.8rem;">&#x26A0;&#xFE0F;</div>
                    <div>
                        <div class="fw-bold" style="color:#92400E;">Hủy sau 24h kể từ khi đặt</div>
                        <div class="text-muted" style="font-size:.9rem;">Bạn chỉ được hoàn <strong>70%</strong> số tiền vào ví, sau khi manager duyệt.</div>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-start p-3" style="background:#F3F4F6;border-radius:10px;">
                    <div style="font-size:1.8rem;">&#x1F4CB;</div>
                    <div>
                        <div class="fw-bold">Quy trình hủy</div>
                        <div class="text-muted" style="font-size:.9rem;">Việc hủy cần được manager phê duyệt. Tiền sẽ được hoàn vào <strong>ví điện tử</strong> trong hệ thống (không hoàn về thẻ/ngân hàng).</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Xem lại</button>
                <button type="button" class="btn btn-primary btn-lg px-4" id="agreeAndPayBtn">
                    <i class="fa-solid fa-lock me-1"></i>Đồng ý &amp; Thanh toán
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const pricePerNight = @((Model.Room.RoomType?.PricePerNight ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const amountDisplay = document.getElementById('totalAmountDisplay');

        function calculateTotal() {
            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);
            
            if (checkIn && checkOut && checkOut > checkIn) {
                const diffTime = Math.abs(checkOut - checkIn);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                const total = diffDays * pricePerNight;
                amountDisplay.innerText = total.toLocaleString('vi-VN') + '₫';
            } else {
                amountDisplay.innerText = '0₫';
            }
        }

        checkInInput.addEventListener('change', () => {
             // Auto advance checkout if checkin changes to be later
             const newCheckIn = new Date(checkInInput.value);
             const currentCheckOut = new Date(checkOutInput.value);
             if (newCheckIn >= currentCheckOut) {
                 const newCheckOut = new Date(newCheckIn);
                 newCheckOut.setDate(newCheckOut.getDate() + 1);
                 checkOutInput.value = newCheckOut.toISOString().split('T')[0];
             }
             calculateTotal();
        });
        checkOutInput.addEventListener('change', calculateTotal);

        // Init
        calculateTotal();

        // Wire modal "Agree and Pay" button to submit the form
        document.getElementById('agreeAndPayBtn').addEventListener('click', function () {
            document.querySelector('form').submit();
        });
    </script>
}
