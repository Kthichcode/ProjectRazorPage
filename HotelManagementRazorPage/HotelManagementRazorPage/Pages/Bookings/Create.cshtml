@page "{roomId:int}"
@model HotelManagementRazorPage.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Đặt phòng";
    var walletBalance = Model.WalletBalance;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="mb-4 text-center">Xác nhận đặt phòng</h2>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary">Phòng @Model.Room.RoomNumber</h5>
                    <p class="card-text text-muted">@Model.Room.RoomType?.Name</p>
                    <hr />
                    <p class="card-text">
                        <strong>Giá mỗi đêm:</strong> 
                        <span class="text-danger fw-bold">@((Model.Room.RoomType?.PricePerNight ?? 0).ToString("N0"))₫</span>
                    </p>
                    <p class="card-text">
                        <strong>Sức chứa tối đa:</strong> @Model.Room.MaxOccupancy người
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation"></i> @Model.ErrorMessage
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" id="bookingForm">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ngày nhận phòng</label>
                                <input type="date" asp-for="CheckIn" class="form-control" 
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required id="checkInDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ngày trả phòng</label>
                                <input type="date" asp-for="CheckOut" class="form-control" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required id="checkOutDate" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Tổng tiền tạm tính:</label>
                            <h4 id="totalAmountDisplay" class="text-primary fw-bold">0₫</h4>
                        </div>

                        <!-- Wallet Balance Info -->
                        <div class="mb-3 p-3 rounded-3 border" style="background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-wallet text-primary"></i>
                                <span class="fw-semibold">Số dư ví của bạn:</span>
                                <span class="text-success fw-bold" id="walletBalanceDisplay">@walletBalance.ToString("N0")₫</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Phương thức thanh toán</label>
                            <select asp-for="PaymentMethod" class="form-select" id="paymentMethodSelect">
                                <option value="VNPay">Thanh toán trực tuyến (VNPay)</option>
                                @if (walletBalance > 0)
                                {
                                    <option value="Wallet">Thanh toán bằng Ví (Số dư: @walletBalance.ToString("N0")₫)</option>
                                }
                                else
                                {
                                    <option value="Wallet" disabled>Thanh toán bằng Ví (Số dư không đủ)</option>
                                }
                            </select>
                        </div>

                        <!-- Wallet split preview (only shown when Wallet is selected) -->
                        <div id="walletSplitPreview" class="mb-4 d-none">
                            <div class="alert alert-info py-2 mb-2">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                <strong>Thanh toán từ ví:</strong>
                                <span id="walletPayPart" class="fw-bold text-success">0₫</span>
                            </div>
                            <div id="vnpayPartRow" class="alert alert-warning py-2 d-none">
                                <i class="fa-brands fa-cc-visa me-1"></i>
                                <strong>Còn lại thanh toán qua VNPay:</strong>
                                <span id="vnpayPayPart" class="fw-bold text-danger">0₫</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#cancellationPolicyModal">
                                <i class="fa-solid fa-check-circle"></i> Xác nhận đặt phòng
                            </button>
                            <a asp-page="/Rooms/Detail" asp-route-id="@Model.Room.Id" class="btn btn-light">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancellation Policy Modal -->
<div class="modal fade" id="cancellationPolicyModal" tabindex="-1" aria-labelledby="policyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header border-0 p-4" style="background: linear-gradient(135deg, #1e3a8a, #3b82f6);">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
                        <i class="fa-solid fa-shield-halved text-white" style="font-size: 1.25rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="policyModalLabel">Xác nhận chính sách</h5>
                        <p class="text-white text-opacity-75 mb-0" style="font-size: 0.8rem;">Vui lòng kiểm tra kỹ thông tin trước khi thanh toán</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="policy-section mb-3 bg-white p-3 rounded-4 border-start border-4 border-success shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-circle-check text-success me-2"></i>
                        <span class="fw-bold text-success">Hủy trước 7 ngày trở lên</span>
                    </div>
                    <p class="text-muted mb-0 small">Bạn được <strong>hoàn tiền 100%</strong> vào ví thành viên sau khi yêu cầu được Manager phê duyệt.</p>
                </div>

                <div class="policy-section mb-3 bg-white p-3 rounded-4 border-start border-4 border-warning shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-circle-exclamation text-warning me-2"></i>
                        <span class="fw-bold text-warning">Hủy trước 4 – 6 ngày</span>
                    </div>
                    <p class="text-muted mb-0 small">Phí hủy phòng là 30%. Bạn sẽ được <strong>hoàn tiền 70%</strong> vào ví thành viên.</p>
                </div>

                <div class="policy-section mb-3 bg-white p-3 rounded-4 border-start border-4 border-danger shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-circle-xmark text-danger me-2"></i>
                        <span class="fw-bold text-danger">Hủy trong vòng 1 – 3 ngày</span>
                    </div>
                    <p class="text-muted mb-0 small">Hủy quá sát ngày nhận phòng sẽ <strong>không được hoàn tiền</strong>.</p>
                </div>

                <div class="policy-section bg-white p-3 rounded-4 border-start border-4 border-primary shadow-sm">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-circle-info text-primary me-2"></i>
                        <span class="fw-bold text-primary">Thông tin quan trọng</span>
                    </div>
                    <ul class="text-muted mb-0 small ps-3">
                        <li>Tiền hoàn chỉ áp dụng cho ví trong hệ thống.</li>
                        <li>Yêu cầu hủy cần được quản lý kiểm tra và duyệt.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0 bg-light">
                <div class="d-flex w-100 gap-2">
                    <button type="button" class="btn btn-outline-secondary w-100 py-2 fw-semibold" style="border-radius: 12px;" data-bs-dismiss="modal">Xem lại</button>
                    <button type="button" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" 
                            id="agreeAndPayBtn" style="border-radius: 12px; background: #1e3a8a; border: none; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.25);">
                        <i class="fa-solid fa-credit-card"></i>
                        Đồng ý &amp; Thanh toán
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 { border-radius: 12px !important; }
    #cancellationPolicyModal .modal-content {
        animation: modalSlideUp 0.3s ease-out;
    }
    @@keyframes modalSlideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

@section Scripts {
    <script>
        const pricePerNight = @((Model.Room.RoomType?.PricePerNight ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const walletBalance = @walletBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
        
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const amountDisplay = document.getElementById('totalAmountDisplay');
        const paymentMethodSelect = document.getElementById('paymentMethodSelect');
        const walletSplitPreview = document.getElementById('walletSplitPreview');
        const walletPayPart = document.getElementById('walletPayPart');
        const vnpayPayPart = document.getElementById('vnpayPayPart');
        const vnpayPartRow = document.getElementById('vnpayPartRow');

        function getNights() {
            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);
            if (!checkIn || !checkOut || checkOut <= checkIn) return 0;
            return Math.ceil(Math.abs(checkOut - checkIn) / (1000 * 60 * 60 * 24));
        }

        function calculateTotal() {
            const nights = getNights();
            const total = nights * pricePerNight;
            amountDisplay.innerText = total > 0 ? total.toLocaleString('vi-VN') + '₫' : '0₫';
            updateWalletPreview(total);
        }

        function updateWalletPreview(total) {
            const method = paymentMethodSelect.value;
            if (method === 'Wallet' && total > 0) {
                walletSplitPreview.classList.remove('d-none');
                const fromWallet = Math.min(walletBalance, total);
                const fromVNPay = total - fromWallet;
                walletPayPart.innerText = fromWallet.toLocaleString('vi-VN') + '₫';
                if (fromVNPay > 0) {
                    vnpayPartRow.classList.remove('d-none');
                    vnpayPayPart.innerText = fromVNPay.toLocaleString('vi-VN') + '₫';
                } else {
                    vnpayPartRow.classList.add('d-none');
                }
            } else {
                walletSplitPreview.classList.add('d-none');
            }
        }

        checkInInput.addEventListener('change', () => {
             const newCheckIn = new Date(checkInInput.value);
             const currentCheckOut = new Date(checkOutInput.value);
             if (newCheckIn >= currentCheckOut) {
                 const newCheckOut = new Date(newCheckIn);
                 newCheckOut.setDate(newCheckOut.getDate() + 1);
                 checkOutInput.value = newCheckOut.toISOString().split('T')[0];
             }
             calculateTotal();
        });
        checkOutInput.addEventListener('change', calculateTotal);
        paymentMethodSelect.addEventListener('change', function () {
            const total = getNights() * pricePerNight;
            updateWalletPreview(total);
        });

        // Init
        calculateTotal();

        // Wire modal "Agree and Pay" button to submit the form
        document.getElementById('agreeAndPayBtn').addEventListener('click', function () {
            document.getElementById('bookingForm').submit();
        });
    </script>
}
