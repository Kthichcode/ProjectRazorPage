@page
@model HotelManagementRazorPage.Pages.Bookings.WalletModel
@using BusinessObjects.Entities
@{
    ViewData["Title"] = "Ví của tôi";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fa-solid fa-wallet me-2 text-success"></i>Ví của tôi</h2>
        <a asp-page="/Bookings/History" class="btn btn-light">
            <i class="fa-solid fa-arrow-left me-1"></i>Lịch sử đặt phòng
        </a>
    </div>

    <!-- Balance Card -->
    <div class="card shadow-sm mb-4 border-0" style="background:linear-gradient(135deg,#10B981,#059669);color:#fff;border-radius:16px;">
        <div class="card-body p-4">
            <div style="font-size:.9rem;opacity:.85;margin-bottom:.5rem;">
                <i class="fa-solid fa-coins me-1"></i>Số dư hiện tại
            </div>
            <div style="font-size:2.5rem;font-weight:800;letter-spacing:-1px;">
                @Model.Wallet.Balance.ToString("N0")₫
            </div>
            <div style="font-size:.8rem;opacity:.7;margin-top:.5rem;">
                Tiền hoàn từ các booking hủy sẽ xuất hiện tại đây
            </div>
        </div>
    </div>

    <!-- Transaction History -->
    <h5 class="mb-3 fw-bold">Lịch sử giao dịch</h5>

    @if (!Model.Transactions.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-receipt" style="font-size:3rem;opacity:.3;"></i>
            <p class="mt-3">Chưa có giao dịch nào.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0" style="border-radius:12px;overflow:hidden;">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mô tả</th>
                            <th class="text-end">Số tiền</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model.Transactions)
                        {
                            <tr>
                                <td>
                                    <i class="fa-solid fa-arrow-down text-success me-2"></i>
                                    @tx.Description
                                </td>
                                <td class="text-end fw-bold text-success">+@tx.Amount.ToString("N0")₫</td>
                                <td class="text-muted" style="font-size:.85rem;">
                                    @tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
