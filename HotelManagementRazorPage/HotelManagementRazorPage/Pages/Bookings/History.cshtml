@page
@model HotelManagementRazorPage.Pages.Bookings.HistoryModel
@using BusinessObjects.Enums
@{
    ViewData["Title"] = "Lịch sử đặt phòng";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2 class="mb-0">Lịch sử đặt phòng của tôi</h2>
        <a asp-page="/Bookings/Wallet" class="btn btn-outline-success d-flex align-items-center gap-2" style="border-radius:20px;">
            <i class="fa-solid fa-wallet"></i>
            <span>Ví: <strong>@Model.WalletBalance.ToString("N0")₫</strong></span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Nút Filter (Search) -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body bg-light rounded">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold"><i class="fa-solid fa-filter text-primary"></i> Trạng thái:</label>
                </div>
                <div class="col-auto">
                    <select asp-for="FilterStatus" class="form-select" asp-items="Html.GetEnumSelectList<BookingStatus>()">
                        <option value="">-- Tất cả --</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm</button>
                    <a asp-page="./History" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Bookings.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-box-open text-muted" style="font-size:4rem;"></i>
            <h4 class="mt-3 text-muted">Không tìm thấy đặt phòng nào.</h4>
            <a asp-page="/Rooms/Index" class="btn btn-primary mt-3">Khám phá các phòng</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model.Bookings)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted" style="font-size:0.85rem;">#@booking.Id &bull; @booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                 @{
                                    var badgeColor = booking.Status switch
                                    {
                                        BookingStatus.Pending => "bg-warning text-dark",
                                        BookingStatus.Confirmed => "bg-info text-dark",
                                        BookingStatus.CheckedIn => "bg-primary",
                                        BookingStatus.Completed => "bg-success",
                                        BookingStatus.Cancelled => "bg-danger",
                                        BookingStatus.CancellationPending => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                @{
                                    var statusText = booking.Status switch
                                    {
                                        BookingStatus.Pending => "Chờ thanh toán",
                                        BookingStatus.Confirmed => "Đã xác nhận",
                                        BookingStatus.CheckedIn => "Đang ở",
                                        BookingStatus.Completed => "Hoàn thành",
                                        BookingStatus.Cancelled => "Đã hủy",
                                        BookingStatus.CancellationPending => "⏳ Chờ duyệt hủy",
                                        _ => booking.Status.ToString()
                                    };
                                }
                                <span class="badge @badgeColor">@statusText</span>
                            </div>
                        </div>
                        <div class="card-body">
                            @{
                                var room = booking.BookingRooms.FirstOrDefault()?.Room;
                                var roomName = room != null ? $"Phòng {room.RoomNumber}" : "N/A";
                            }
                            <h5 class="card-title fw-bold">@roomName</h5>
                            
                            <div class="d-flex my-3 gap-3">
                                <div class="p-2 bg-light rounded" style="flex:1;">
                                    <div style="font-size:0.75rem; color:#6c757d;">Nhận phòng</div>
                                    <div class="fw-bold fs-6">@booking.CheckInDate.ToString("dd/MM")</div>
                                </div>
                                <div class="p-2 bg-light rounded" style="flex:1;">
                                    <div style="font-size:0.75rem; color:#6c757d;">Trả phòng</div>
                                    <div class="fw-bold fs-6">@booking.CheckOutDate.ToString("dd/MM")</div>
                                </div>
                            </div>
                            
                         <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="text-muted">Tổng cộng</span>
                                <span class="fw-bold text-danger fs-5">@booking.TotalAmount.ToString("N0")₫</span>
                            </div>
                            @if (booking.Status == BookingStatus.Cancelled && booking.RefundAmount.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted" style="font-size:.85rem;">✅ Hoàn ví</span>
                                    <span class="fw-bold text-success">+@booking.RefundAmount.Value.ToString("N0")₫</span>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                         <div class="d-flex gap-2 flex-wrap">
                                <a asp-page="/Admin/Bookings/Details" asp-route-id="@booking.Id" class="btn btn-outline-primary btn-sm flex-grow-1">Chi tiết</a>
                                @if (booking.Status == BookingStatus.Pending)
                                {
                                    <form method="post" asp-page-handler="RetryPayment" asp-route-id="@booking.Id" class="flex-grow-1 m-0">
                                        <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold">
                                            <i class="fa-solid fa-credit-card me-1"></i>Thanh toán ngay
                                        </button>
                                    </form>
                                }
                                @if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Confirmed)
                                {
                                    if (booking.CheckInDate >= DateTime.Today)
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@booking.Id" class="flex-grow-1 m-0">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                    onclick="return confirm('Bạn có chắc muốn gửi yêu cầu hủy? Tiền sẽ được hoàn vào ví sau khi manager duyệt.')">
                                                <i class="fa-solid fa-xmark me-1"></i>Gửi yêu cầu hủy
                                            </button>
                                        </form>
                                    }
                                }
                                @if (booking.Status == BookingStatus.CancellationPending)
                                {
                                    <span class="btn btn-outline-warning btn-sm flex-grow-1 disabled">
                                        <i class="fa-solid fa-hourglass-half me-1"></i>Chờ manager duyệt
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
