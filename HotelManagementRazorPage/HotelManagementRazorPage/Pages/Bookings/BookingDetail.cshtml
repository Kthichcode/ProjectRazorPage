@page "{id:int}"
@model HotelManagementRazorPage.Pages.Bookings.BookingDetailModel
@using BusinessObjects.Enums
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.Booking.Id}";
    var b      = Model.Booking;
    var nights = (b.CheckOutDate - b.CheckInDate).Days;
    var room   = b.BookingRooms.FirstOrDefault()?.Room;
}

<style>
    :root {
        --blue:     #0066CC; --blue-dark:#004FA3;
        --blue-dim: #E8F0FE; --divider:  #D2D2D7;
        --bg:       #FFFFFF; --bg-alt:   #F5F5F7;
        --text:     #1D1D1F; --text-sub: #6E6E73;
    }
    .detail-wrap { max-width: 760px; margin: 0 auto; padding: 2.5rem 1rem 5rem; }

    /* breadcrumb */
    .breadcrumb-row { display:flex; align-items:center; gap:.5rem; font-size:.8rem; color:var(--text-sub); margin-bottom:1.6rem; }
    .breadcrumb-row a { color:var(--blue); text-decoration:none; }
    .breadcrumb-row a:hover { text-decoration:underline; }
    .breadcrumb-row .sep { color:var(--divider); }

    /* status hero banner */
    .status-banner {
        border-radius: 16px; padding: 1.4rem 1.6rem;
        display: flex; align-items: center; gap: 1rem;
        margin-bottom: 1.6rem;
    }
    .status-banner-icon { font-size: 1.8rem; flex-shrink: 0; }
    .status-banner-title { font-size: 1.1rem; font-weight: 800; }
    .status-banner-sub   { font-size: .8rem; margin-top: .15rem; }
    .ban-confirmed   { background: var(--blue-dim);  }
    .ban-confirmed   .status-banner-icon, .ban-confirmed   .status-banner-title { color: var(--blue-dark); }
    .ban-checkedin   { background: #DCFCE7; }
    .ban-checkedin   .status-banner-icon, .ban-checkedin   .status-banner-title { color: #166534; }
    .ban-completed   { background: #DCFCE7; }
    .ban-completed   .status-banner-icon, .ban-completed   .status-banner-title { color: #166534; }
    .ban-cancelled   { background: #FEE2E2; }
    .ban-cancelled   .status-banner-icon, .ban-cancelled   .status-banner-title { color: #991B1B; }
    .ban-pending     { background: #FEF3C7; }
    .ban-pending     .status-banner-icon, .ban-pending     .status-banner-title { color: #92400E; }
    .ban-cancelpend  { background: #FEF3C7; border: 1px solid #FDE68A; }
    .ban-cancelpend  .status-banner-icon, .ban-cancelpend  .status-banner-title { color: #92400E; }

    /* section card */
    .det-card {
        background: var(--bg); border: 1px solid var(--divider);
        border-radius: 16px; overflow: hidden;
        margin-bottom: 1rem;
    }
    .det-card-head {
        padding: .9rem 1.4rem;
        border-bottom: 1px solid var(--divider);
        display: flex; align-items: center; gap: .5rem;
        background: var(--bg-alt);
    }
    .det-card-head-title { font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-sub); }
    .det-card-body { padding: 1.2rem 1.4rem; }

    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @@media (max-width: 480px) { .info-grid { grid-template-columns: 1fr; } }

    .info-item-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-sub); margin-bottom: .25rem; }
    .info-item-value { font-size: .92rem; font-weight: 600; color: var(--text); }

    /* date pair */
    .date-pair { display: flex; gap: .75rem; }
    .date-box { flex:1; background:var(--bg-alt); border-radius:10px; padding:.9rem 1.1rem; }
    .date-box-lbl { font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--text-sub); }
    .date-box-val { font-size:1.05rem; font-weight:800; color:var(--text); margin-top:.25rem; }
    .date-box-sub { font-size:.72rem; color:var(--text-sub); }

    /* room pills */
    .room-pill { display:inline-block; padding:.2rem .65rem; border-radius:6px; background:var(--blue-dim); color:var(--blue); font-size:.72rem; font-weight:700; margin:.15rem; }

    /* payment row */
    .pay-row { display:flex; justify-content:space-between; align-items:center; padding:.65rem 0; border-bottom:1px solid var(--bg-alt); font-size:.875rem; }
    .pay-row:last-child { border-bottom: none; }
    .pay-lbl { color: var(--text-sub); }
    .pay-val { font-weight: 700; color: var(--text); }
    .pay-total { font-size: 1.2rem; font-weight: 900; color: var(--blue); }

    /* refund badge */
    .refund-badge { display:inline-flex; align-items:center; gap:.4rem; padding:.35rem .9rem; border-radius:8px; background:#DCFCE7; color:#166534; font-size:.825rem; font-weight:700; margin-top:.75rem; }

    /* actions */
    .det-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1.4rem; }
    .btn-det { display:inline-flex; align-items:center; gap:.4rem; padding:.6rem 1.3rem; border-radius:10px; font-size:.845rem; font-weight:700; text-decoration:none; cursor:pointer; border:none; transition:all .2s; }
    .btn-det-back    { background:var(--bg-alt); color:var(--text); border:1px solid var(--divider); }
    .btn-det-back:hover    { border-color:var(--blue); color:var(--blue); background:var(--blue-dim); }
    .btn-det-primary { background:var(--blue); color:#fff; }
    .btn-det-primary:hover { background:var(--blue-dark); color:#fff; }
    .btn-det-cancel  { background:none; color:#DC2626; border:1px solid #FCA5A5; }
    .btn-det-cancel:hover  { background:#FEF2F2; border-color:#DC2626; }
</style>

<div class="detail-wrap">
    <!-- Breadcrumb -->
    <div class="breadcrumb-row">
        <a asp-page="/Index"><i class="fa-solid fa-house"></i></a>
        <span class="sep">/</span>
        <a asp-page="/Bookings/History">Lịch sử đặt phòng</a>
        <span class="sep">/</span>
        <span>Đơn #@b.Id</span>
    </div>

    <!-- Status banner -->
    @{
        string banCls = b.Status switch {
            BookingStatus.Confirmed          => "ban-confirmed",
            BookingStatus.CheckedIn          => "ban-checkedin",
            BookingStatus.Completed          => "ban-completed",
            BookingStatus.Cancelled          => "ban-cancelled",
            BookingStatus.CancellationPending => "ban-cancelpend",
            _                               => "ban-pending"
        };
        string banIcon = b.Status switch {
            BookingStatus.Confirmed          => "fa-circle-check",
            BookingStatus.CheckedIn          => "fa-bed",
            BookingStatus.Completed          => "fa-flag-checkered",
            BookingStatus.Cancelled          => "fa-circle-xmark",
            BookingStatus.CancellationPending => "fa-hourglass-half",
            _                               => "fa-clock"
        };
        string banTitle = b.Status switch {
            BookingStatus.Confirmed          => "Đã xác nhận",
            BookingStatus.CheckedIn          => "Đang lưu trú",
            BookingStatus.Completed          => "Hoàn thành",
            BookingStatus.Cancelled          => "Đã hủy",
            BookingStatus.CancellationPending => "Chờ duyệt hủy",
            _                               => "Chờ xác nhận"
        };
        string banSub = b.Status switch {
            BookingStatus.Confirmed          => "Đặt phòng đã được xác nhận. Vui lòng đến đúng ngày nhận phòng.",
            BookingStatus.CheckedIn          => "Bạn đang lưu trú tại khách sạn.",
            BookingStatus.Completed          => "Cảm ơn bạn đã lưu trú. Hẹn gặp lại!",
            BookingStatus.Cancelled          => "Đặt phòng đã bị hủy.",
            BookingStatus.CancellationPending => "Yêu cầu hủy đang chờ quản lý duyệt.",
            _                               => "Đặt phòng của bạn đang chờ xác nhận."
        };
    }
    <div class="status-banner @banCls">
        <div class="status-banner-icon"><i class="fa-solid @banIcon"></i></div>
        <div>
            <div class="status-banner-title">@banTitle</div>
            <div class="status-banner-sub" style="color:var(--text-sub);">@banSub</div>
        </div>
        <div class="ms-auto" style="font-size:.78rem;color:var(--text-sub);text-align:right;">
            Mã đơn<br><strong style="font-size:1rem;color:var(--text);">#@b.Id</strong>
        </div>
    </div>

    <!-- Customer info -->
    <div class="det-card">
        <div class="det-card-head">
            <i class="fa-solid fa-user" style="color:var(--blue);font-size:.85rem;"></i>
            <span class="det-card-head-title">Thông tin khách hàng</span>
        </div>
        <div class="det-card-body">
            <div class="info-grid">
                <div>
                    <div class="info-item-label">Họ tên</div>
                    <div class="info-item-value">@(b.Customer?.FullName ?? b.Customer?.UserName ?? "—")</div>
                </div>
                <div>
                    <div class="info-item-label">Số điện thoại</div>
                    <div class="info-item-value">@(b.Customer?.PhoneNumber ?? "—")</div>
                </div>
                <div>
                    <div class="info-item-label">Email</div>
                    <div class="info-item-value" style="font-size:.85rem;">@(b.Customer?.Email ?? "—")</div>
                </div>
                <div>
                    <div class="info-item-label">Ngày đặt</div>
                    <div class="info-item-value">@b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Room info -->
    <div class="det-card">
        <div class="det-card-head">
            <i class="fa-solid fa-bed" style="color:var(--blue);font-size:.85rem;"></i>
            <span class="det-card-head-title">Thông tin phòng</span>
        </div>
        <div class="det-card-body">
            <div class="info-grid mb-3">
                <div>
                    <div class="info-item-label">Phòng đặt</div>
                    <div class="info-item-value">
                        @foreach (var br in b.BookingRooms)
                        {
                            <span class="room-pill">P.@br.Room?.RoomNumber</span>
                        }
                    </div>
                </div>
                <div>
                    <div class="info-item-label">Loại phòng</div>
                    <div class="info-item-value">@(room?.RoomType?.Name ?? "—")</div>
                </div>
                <div>
                    <div class="info-item-label">Sức chứa</div>
                    <div class="info-item-value">@(room?.MaxOccupancy ?? 0) khách</div>
                </div>
                <div>
                    <div class="info-item-label">Giá mỗi đêm</div>
                    <div class="info-item-value">@((room?.RoomType?.PricePerNight ?? 0).ToString("N0"))₫</div>
                </div>
            </div>
            <div class="date-pair">
                <div class="date-box">
                    <div class="date-box-lbl">Nhận phòng</div>
                    <div class="date-box-val">@b.CheckInDate.ToString("dd/MM/yyyy")</div>
                    <div class="date-box-sub">@b.CheckInDate.ToString("dddd")</div>
                </div>
                <div class="date-box">
                    <div class="date-box-lbl">Trả phòng</div>
                    <div class="date-box-val">@b.CheckOutDate.ToString("dd/MM/yyyy")</div>
                    <div class="date-box-sub">@b.CheckOutDate.ToString("dddd")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment info -->
    <div class="det-card">
        <div class="det-card-head">
            <i class="fa-solid fa-credit-card" style="color:var(--blue);font-size:.85rem;"></i>
            <span class="det-card-head-title">Thanh toán</span>
        </div>
        <div class="det-card-body">
            <div class="pay-row">
                <span class="pay-lbl">Giá phòng (@nights đêm)</span>
                <span class="pay-val">@b.TotalAmount.ToString("N0")₫</span>
            </div>
            @if (b.Payments.Any())
            {
                foreach (var p in b.Payments)
                {
                    <div class="pay-row">
                        <span class="pay-lbl">Phương thức: @p.Method</span>
                        <span class="pay-val" style="color:#16A34A;">✓ @p.Amount.ToString("N0")₫</span>
                    </div>
                }
            }
            <div class="pay-row" style="border-top:2px solid var(--divider);margin-top:.4rem;padding-top:.9rem;">
                <span class="pay-lbl" style="font-weight:700;color:var(--text);">Tổng cộng</span>
                <span class="pay-total">@b.TotalAmount.ToString("N0")₫</span>
            </div>
            @if (b.Status == BookingStatus.Cancelled && b.RefundAmount.HasValue)
            {
                <div class="refund-badge">
                    <i class="fa-solid fa-rotate-left"></i>
                    Đã hoàn ví: <strong>+@b.RefundAmount.Value.ToString("N0")₫</strong>
                </div>
            }
        </div>
    </div>

    <!-- Actions -->
    <div class="det-actions">
        <a asp-page="/Bookings/History" class="btn-det btn-det-back">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
        <a asp-page="/Rooms/Detail" asp-route-id="@(room?.Id ?? 0)" class="btn-det btn-det-primary">
            <i class="fa-solid fa-eye"></i> Xem phòng
        </a>
    </div>
</div>
