@using System.Security.Claims
@using Services.Interfaces
@inject IWalletService WalletService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mường Thanh Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary:   #1565C0;
            --primary-d: #0D47A1;
            --primary-l: #1976D2;
            --accent:    #42A5F5;
            --white:     #FFFFFF;
            --gray-50:   #F8FAFF;
            --gray-100:  #EFF4FF;
            --gray-400:  #94A3B8;
            --text:      #1E293B;
            --text-sub:  #64748B;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: var(--white);
        }

        /* ── NAVBAR ── */
        .site-navbar {
            background: var(--white);
            border-bottom: 1px solid #E2EAF4;
            padding: 0 1rem;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 12px rgba(21,101,192,.08);
        }

        .navbar-brand-mt {
            font-family: 'Playfair Display', serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--primary) !important;
            text-decoration: none;
            letter-spacing: .3px;
            white-space: nowrap;
        }
        .navbar-brand-mt i { color: var(--accent); }

        .site-navbar .nav-link {
            color: var(--text-sub) !important;
            font-size: .875rem;
            font-weight: 500;
            padding: .4rem .9rem !important;
            border-radius: 6px;
            transition: color .2s, background .2s;
        }
        .site-navbar .nav-link:hover {
            color: var(--primary) !important;
            background: var(--gray-100);
        }

        .navbar-toggler { border: none; padding: .3rem .6rem; }
        .navbar-toggler:focus { box-shadow: none; }

        .btn-nav-login {
            border: 1.5px solid var(--primary);
            color: var(--primary) !important;
            border-radius: 8px;
            padding: .38rem 1rem !important;
            font-size: .875rem;
            font-weight: 600;
            transition: all .2s;
        }
        .btn-nav-login:hover {
            background: var(--primary);
            color: var(--white) !important;
        }

        .btn-nav-register {
            background: var(--primary);
            color: var(--white) !important;
            border-radius: 8px;
            padding: .38rem 1rem !important;
            font-size: .875rem;
            font-weight: 600;
            transition: all .2s;
            border: 1.5px solid var(--primary);
        }
        .btn-nav-register:hover {
            background: var(--primary-d);
            border-color: var(--primary-d);
        }

        .nav-user-text {
            color: var(--primary) !important;
            font-weight: 600;
            font-size: .875rem;
        }

        .btn-nav-logout {
            background: none;
            border: 1.5px solid #CBD5E1;
            color: var(--text-sub) !important;
            border-radius: 8px;
            padding: .38rem 1rem !important;
            font-size: .875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s;
        }
        .btn-nav-logout:hover {
            border-color: #EF4444;
            color: #EF4444 !important;
        }

        /* ── WALLET PILL (NAVBAR) ── */
        .nav-wallet-pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .3rem .8rem;
            background: #EBF8F2;
            border: 1.5px solid #A7EBC7;
            border-radius: 980px;
            font-size: .8rem;
            font-weight: 600;
            color: #1A6640 !important;
            text-decoration: none;
            transition: all .2s;
        }
        .nav-wallet-pill:hover {
            background: #D1FAE5;
            border-color: #059669;
            color: #059669 !important;
        }
        .nav-wallet-pill i { color: #059669; font-size: .78rem; }

        /* ── FOOTER ── */
        .site-footer {
            background: var(--primary-d);
            color: rgba(255,255,255,.75);
            padding: 2rem 0 1.2rem;
            font-size: .82rem;
            margin-top: auto;
        }
        .site-footer .footer-brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--white);
            font-weight: 700;
        }
        .site-footer a { color: rgba(255,255,255,.6); text-decoration: none; }
        .site-footer a:hover { color: var(--white); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- NAVBAR -->
    <nav class="site-navbar navbar navbar-expand-lg">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand-mt" asp-page="/Index">
                <i class="fa-solid fa-hotel me-2"></i>Mường Thanh Hotel
            </a>

            <!-- Hamburger (mobile only) -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#siteNav"
                    aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars" style="color:var(--primary);font-size:1.1rem;"></i>
            </button>

            <!-- Collapsible menu -->
            <div class="collapse navbar-collapse" id="siteNav">
                <!-- Left links -->
                <ul class="navbar-nav me-auto gap-1 ms-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="fa-solid fa-house me-1"></i>Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Rooms/Index">
                            <i class="fa-solid fa-bed me-1"></i>Phòng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Rooms/Index"
                           style="background:var(--primary);color:#fff!important;border-radius:8px;padding:.35rem .9rem;font-weight:600;font-size:.85rem;display:inline-flex;align-items:center;gap:.35rem;">
                            <i class="fa-solid fa-magnifying-glass"></i>Tìm phòng
                        </a>
                    </li>
                </ul>

                <!-- Right auth buttons -->
                <ul class="navbar-nav align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link nav-user-text">
                                <i class="fa-solid fa-circle-user me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        @if (!User.IsInRole("Admin") && !User.IsInRole("Manager") && !User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                @{
                                    var walletUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                                    var walletBal = walletUserId != null ? (WalletService.GetUserWallet(walletUserId)?.Balance ?? 0) : 0;
                                }
                                <a class="nav-link nav-wallet-pill" asp-page="/Bookings/Wallet">
                                    <i class="fa-solid fa-wallet"></i>@walletBal.ToString("N0")₫
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/History">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i>Đơn đặt phòng
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-nav-register" asp-page="/Admin/Index">
                                    <i class="fa-solid fa-gear me-1"></i>Admin
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Manager/Index"
                                   style="background:#0D7055;color:#fff!important;border-radius:8px;padding:.38rem 1rem;font-size:.875rem;font-weight:600;border:1.5px solid #0D7055;transition:all .2s;"
                                   onmouseover="this.style.background='#085C44';this.style.borderColor='#085C44';"
                                   onmouseout="this.style.background='#0D7055';this.style.borderColor='#0D7055';">
                                    <i class="fa-solid fa-user-tie me-1"></i>Quản lý
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/RoomDashboard"
                                   style="background:var(--primary);color:#fff!important;border-radius:8px;padding:.38rem 1rem;font-size:.875rem;font-weight:600;border:1.5px solid var(--primary);transition:all .2s;">
                                    <i class="fa-solid fa-user-gear me-1"></i>Nhân viên
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <form asp-page="/Account/Logout" method="post" class="m-0">
                                <button type="submit" class="nav-link btn-nav-logout">
                                    <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn-nav-login" asp-page="/Account/Login">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-register" asp-page="/Account/Register">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container text-center">
            <div class="footer-brand mb-1">
                <i class="fa-solid fa-hotel me-2"></i>Mường Thanh Hotel
            </div>
            <p class="mb-0">&copy; 2026 Mường Thanh Hotel. Bảo lưu mọi quyền.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ══════════════ AI CHAT WIDGET ══════════════ -->
    <style>
        /* ── Chat Bubble Button ── */
        .ai-chat-bubble {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 9999;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1565C0, #42A5F5);
            border: none;
            cursor: pointer;
            box-shadow: 0 6px 24px rgba(21,101,192,.45);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform .25s, box-shadow .25s;
            animation: chat-pulse 2.5s infinite;
        }
        .ai-chat-bubble:hover {
            transform: scale(1.1);
            box-shadow: 0 10px 32px rgba(21,101,192,.55);
            animation: none;
        }
        .ai-chat-bubble i { color: #fff; font-size: 1.5rem; transition: transform .3s; }
        .ai-chat-bubble.open i { transform: rotate(90deg); }

        /* Notification dot */
        .chat-notif-dot {
            position: absolute;
            top: 4px; right: 4px;
            width: 14px; height: 14px;
            border-radius: 50%;
            background: #EF4444;
            border: 2px solid #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: .55rem; color: #fff; font-weight: 700;
        }

        @@keyframes chat-pulse {
            0%, 100% { box-shadow: 0 6px 24px rgba(21,101,192,.45); }
            50%  { box-shadow: 0 6px 36px rgba(21,101,192,.7), 0 0 0 8px rgba(21,101,192,.1); }
        }

        /* ── Chat Popup ── */
        .ai-chat-popup {
            position: fixed;
            bottom: 100px;
            right: 28px;
            z-index: 9998;
            width: 480px;
            max-width: calc(100vw - 40px);
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 24px 64px rgba(0,0,0,.18);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transform: translateY(20px) scale(.95);
            opacity: 0;
            pointer-events: none;
            transition: all .3s cubic-bezier(.34,1.56,.64,1);
            border: 1px solid rgba(21,101,192,.12);
        }
        .ai-chat-popup.visible {
            transform: translateY(0) scale(1);
            opacity: 1;
            pointer-events: all;
        }

        /* Header */
        .chat-header {
            background: linear-gradient(135deg, #0D47A1, #1565C0);
            padding: 1rem 1.2rem;
            display: flex;
            align-items: center;
            gap: .8rem;
            flex-shrink: 0;
        }
        .chat-header-avatar {
            width: 42px; height: 42px;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; color: #fff; flex-shrink: 0;
        }
        .chat-header-info { flex: 1; min-width: 0; }
        .chat-header-name {
            color: #fff; font-weight: 700; font-size: .95rem; line-height: 1.2;
        }
        .chat-header-status {
            display: flex; align-items: center; gap: .35rem;
            color: rgba(255,255,255,.75); font-size: .75rem; margin-top: .15rem;
        }
        .status-dot {
            width: 7px; height: 7px; border-radius: 50%; background: #4ADE80;
            flex-shrink: 0;
        }
        .chat-close-btn {
            background: rgba(255,255,255,.15); border: none;
            border-radius: 8px; color: rgba(255,255,255,.8);
            width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: background .2s; font-size: .9rem;
            flex-shrink: 0;
        }
        .chat-close-btn:hover { background: rgba(255,255,255,.25); color: #fff; }

        /* Messages area */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: .75rem;
            max-height: 480px;
            min-height: 200px;
            background: #F8FAFF;
        }
        .chat-messages::-webkit-scrollbar { width: 4px; }
        .chat-messages::-webkit-scrollbar-track { background: transparent; }
        .chat-messages::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 2px; }

        /* Message bubbles */
        .chat-msg {
            display: flex;
            align-items: flex-end;
            gap: .5rem;
            animation: msgIn .25s ease forwards;
        }
        @@keyframes msgIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .chat-msg.user { flex-direction: row-reverse; }

        .msg-avatar {
            width: 30px; height: 30px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .85rem; flex-shrink: 0;
        }
        .msg-avatar.ai  { background: linear-gradient(135deg,#1565C0,#42A5F5); color:#fff; }
        .msg-avatar.usr { background: #E2EAF4; color: #1565C0; }

        .msg-bubble {
            max-width: 78%;
            padding: .65rem .95rem;
            border-radius: 16px;
            font-size: .875rem;
            line-height: 1.55;
            word-break: break-word;
        }
        .chat-msg.user .msg-bubble {
            background: linear-gradient(135deg, #1565C0, #1976D2);
            color: #fff;
            border-bottom-right-radius: 4px;
        }
        .chat-msg.ai .msg-bubble {
            background: #fff;
            color: #1E293B;
            border: 1px solid #E2EAF4;
            border-bottom-left-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

        /* Typing indicator */
        .typing-indicator {
            display: flex; align-items: center; gap: .4rem;
            padding: .65rem .95rem;
            background: #fff; border: 1px solid #E2EAF4;
            border-radius: 16px; border-bottom-left-radius: 4px;
            width: fit-content; box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }
        .typing-dot {
            width: 7px; height: 7px;
            border-radius: 50%; background: #94A3B8;
            animation: typing .9s infinite;
        }
        .typing-dot:nth-child(2) { animation-delay: .2s; }
        .typing-dot:nth-child(3) { animation-delay: .4s; }
        @@keyframes typing {
            0%,60%,100% { transform: translateY(0); opacity: .5; }
            30% { transform: translateY(-5px); opacity: 1; }
        }

        /* Room suggestion cards */
        .room-suggestions { display: flex; flex-direction: column; gap: .5rem; margin-top: .5rem; }
        .room-suggest-card {
            background: #F0F7FF;
            border: 1px solid #BFDBFE;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            transition: all .2s;
        }
        .room-suggest-card:hover {
            border-color: #1565C0;
            box-shadow: 0 4px 16px rgba(21,101,192,.12);
        }
        .room-suggest-card > :first-child {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            padding: .7rem .9rem .5rem;
        }
        .room-suggest-img {
            width: 52px; height: 52px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
            background: #CBD5E1;
        }
        .room-suggest-info { flex: 1; min-width: 0; }
        .room-suggest-name {
            font-weight: 700; font-size: .82rem;
            color: #1565C0; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis;
        }
        .room-suggest-type {
            font-size: .72rem; color: #64748B; margin-top: .1rem;
        }
        .room-suggest-price {
            font-weight: 700; font-size: .82rem;
            color: #0D47A1; white-space: nowrap;
            flex-shrink: 0; text-align: right;
            line-height: 1.3;
        }
        .room-suggest-price small {
            display: block; font-weight: 400; font-size: .68rem; color: #94A3B8;
        }

        /* Reason text */
        .room-reason {
            font-size: .72rem; color: #64748B; font-style: italic;
            margin-top: .15rem; white-space: normal;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* Price inline (inside card info) */
        .room-suggest-price-inline {
            font-weight: 700; font-size: .82rem;
            color: #0D47A1; margin-top: .25rem;
        }
        .room-suggest-price-inline span {
            font-weight: 400; font-size: .7rem; color: #94A3B8;
        }

        /* Action buttons */
        .room-suggest-actions {
            display: flex; gap: .4rem;
            padding: .5rem .9rem .7rem;
            border-top: 1px solid #E2EAF4;
            background: #F8FAFF;
        }
        .rsa-btn {
            flex: 1; display: flex; align-items: center; justify-content: center;
            gap: .3rem; padding: .4rem .5rem;
            border-radius: 8px; font-size: .75rem; font-weight: 600;
            text-decoration: none; transition: all .2s;
        }
        .rsa-detail {
            background: #EFF4FF; color: #1565C0;
            border: 1.5px solid #BFDBFE;
        }
        .rsa-detail:hover { background: #DBEAFE; border-color: #1565C0; }
        .rsa-book {
            background: #1565C0; color: #fff;
            border: 1.5px solid #1565C0;
        }
        .rsa-book:hover { background: #0D47A1; border-color: #0D47A1; color: #fff; }

        /* Quick suggest chips */
        .quick-chips {
            padding: .5rem 1rem .25rem;
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            background: #F8FAFF;
            border-top: 1px solid #E2EAF4;
        }
        .quick-chip {
            background: #EFF4FF;
            border: 1px solid #BFDBFE;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 600;
            color: #1565C0;
            padding: .25rem .7rem;
            cursor: pointer;
            transition: all .2s;
            white-space: nowrap;
        }
        .quick-chip:hover { background: #1565C0; color: #fff; border-color: #1565C0; }

        /* Input area */
        .chat-input-area {
            padding: .75rem 1rem;
            display: flex;
            align-items: center;
            gap: .6rem;
            background: #fff;
            border-top: 1px solid #E2EAF4;
            flex-shrink: 0;
        }
        .chat-input {
            flex: 1;
            border: 1.5px solid #CBD5E1;
            border-radius: 24px;
            padding: .6rem 1rem;
            font-size: .875rem;
            outline: none;
            font-family: 'Inter', sans-serif;
            transition: border-color .2s;
            resize: none;
            max-height: 80px;
            min-height: 40px;
            line-height: 1.45;
        }
        .chat-input:focus { border-color: #1565C0; }
        .chat-send-btn {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1565C0, #1976D2);
            border: none;
            color: #fff;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: all .2s;
            font-size: .9rem;
            flex-shrink: 0;
        }
        .chat-send-btn:hover { background: linear-gradient(135deg,#0D47A1,#1565C0); transform: scale(1.08); }
        .chat-send-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }

        /* Responsive */
        @@media (max-width: 480px) {
            .ai-chat-popup { right: 12px; bottom: 90px; width: calc(100vw - 24px); }
            .ai-chat-bubble { right: 16px; bottom: 20px; }
        }
    </style>

    <!-- Bubble Button -->
    <button class="ai-chat-bubble" id="chatBubble" title="Chat với AI tìm phòng" aria-label="Mở chat AI">
        <span class="chat-notif-dot" id="chatNotifDot">1</span>
        <i class="fa-solid fa-robot" id="chatBubbleIcon"></i>
    </button>

    <!-- Chat Popup -->
    <div class="ai-chat-popup" id="chatPopup" role="dialog" aria-modal="true" aria-label="Chat với AI">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-avatar">
                <i class="fa-solid fa-robot"></i>
            </div>
            <div class="chat-header-info">
                <div class="chat-header-name">Trợ lý AI Mường Thanh</div>
                <div class="chat-header-status">
                    <span class="status-dot"></span>
                    <span>Sẵn sàng hỗ trợ &bull; Hỗ trợ 24/7</span>
                </div>
            </div>
            <button class="chat-close-btn" id="chatCloseBtn" aria-label="Đóng chat">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Messages -->
        <div class="chat-messages" id="chatMessages">
            <!-- Tin nhắn chào mừng -->
            <div class="chat-msg ai">
                <div class="msg-avatar ai"><i class="fa-solid fa-robot"></i></div>
                <div class="msg-bubble">
                    👋 Xin chào! Tôi là trợ lý AI của <strong>Mường Thanh Hotel</strong>.<br><br>
                    Hãy cho tôi biết yêu cầu của bạn — số người, ngân sách, ngày nhận phòng — và tôi sẽ gợi ý những phòng phù hợp nhất! 🏨
                </div>
            </div>
        </div>

        <!-- Quick suggestion chips -->
        <div class="quick-chips" id="quickChips">
            <span class="quick-chip" onclick="sendQuickMessage(this)">Phòng cho 2 người</span>
            <span class="quick-chip" onclick="sendQuickMessage(this)">Ngân sách 1 triệu/đêm</span>
            <span class="quick-chip" onclick="sendQuickMessage(this)">Phòng VIP cao cấp</span>
            <span class="quick-chip" onclick="sendQuickMessage(this)">Còn phòng trống không?</span>
        </div>

        <!-- Input -->
        <div class="chat-input-area">
            <textarea class="chat-input" id="chatInput"
                      placeholder="Nhập yêu cầu của bạn..."
                      rows="1"
                      aria-label="Nhập tin nhắn"></textarea>
            <button class="chat-send-btn" id="chatSendBtn" aria-label="Gửi">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <script>
        (function () {
            const bubble   = document.getElementById('chatBubble');
            const popup    = document.getElementById('chatPopup');
            const closeBtn = document.getElementById('chatCloseBtn');
            const input    = document.getElementById('chatInput');
            const sendBtn  = document.getElementById('chatSendBtn');
            const messages = document.getElementById('chatMessages');
            const notifDot = document.getElementById('chatNotifDot');
            const quickChips = document.getElementById('quickChips');

            let chatHistory = [];
            let isOpen = false;
            let isLoading = false;

            const FALLBACK_IMG = 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=200&q=80';

            // ── Toggle popup ──
            function openChat() {
                isOpen = true;
                popup.classList.add('visible');
                bubble.classList.add('open');
                notifDot.style.display = 'none';
                document.getElementById('chatBubbleIcon').className = 'fa-solid fa-xmark';
                setTimeout(() => input.focus(), 300);
                scrollToBottom();
            }

            function closeChat() {
                isOpen = false;
                popup.classList.remove('visible');
                bubble.classList.remove('open');
                document.getElementById('chatBubbleIcon').className = 'fa-solid fa-robot';
            }

            bubble.addEventListener('click', () => isOpen ? closeChat() : openChat());
            closeBtn.addEventListener('click', closeChat);

            // ── Auto-grow textarea ──
            input.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 80) + 'px';
            });

            // ── Send on Enter (Shift+Enter = newline) ──
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
            });
            sendBtn.addEventListener('click', sendMessage);

            // ── Quick chips ──
            window.sendQuickMessage = function (el) {
                input.value = el.textContent;
                sendMessage();
            };

            // ── Scroll to bottom ──
            function scrollToBottom() {
                setTimeout(() => messages.scrollTop = messages.scrollHeight, 50);
            }

            // ── Append bubble ──
            function appendMessage(role, html, rooms) {
                const isUser = role === 'user';
                const wrapper = document.createElement('div');
                wrapper.className = 'chat-msg ' + (isUser ? 'user' : 'ai');

                const avatar = document.createElement('div');
                avatar.className = 'msg-avatar ' + (isUser ? 'usr' : 'ai');
                avatar.innerHTML = isUser
                    ? '<i class="fa-solid fa-user"></i>'
                    : '<i class="fa-solid fa-robot"></i>';

                const bubble = document.createElement('div');
                bubble.className = 'msg-bubble';
                bubble.innerHTML = formatMessage(html);

                // Room suggestion cards
                if (rooms && rooms.length > 0) {
                    const cardsWrap = document.createElement('div');
                    cardsWrap.className = 'room-suggestions';
                    rooms.forEach(r => {
                        const img = r.imageUrl ? r.imageUrl : FALLBACK_IMG;
                        const price = Number(r.pricePerNight).toLocaleString('vi-VN');
                        const detailUrl = '/Rooms/Detail/' + r.id;

                        const card = document.createElement('div');
                        card.className = 'room-suggest-card';
                        card.style.cursor = 'default';
                        card.innerHTML = `
                            <img class="room-suggest-img" src="${img}" alt="Phòng ${r.roomNumber}"
                                 onerror="this.src='${FALLBACK_IMG}'" />
                            <div class="room-suggest-info">
                                <div class="room-suggest-name">Phòng ${r.roomNumber}</div>
                                <div class="room-suggest-type">${r.roomType} &bull; ${r.maxOccupancy} người</div>
                                ${r.reason ? `<div class="room-reason">💡 ${r.reason}</div>` : ''}
                                <div class="room-suggest-price-inline">${price}₫<span>/đêm</span></div>
                            </div>`;

                        // Nút hành động
                        const actions = document.createElement('div');
                        actions.className = 'room-suggest-actions';
                        actions.innerHTML = `
                            <a href="${detailUrl}" class="rsa-btn rsa-detail">
                                <i class="fa-solid fa-eye"></i> Chi tiết
                            </a>
                            <a href="${detailUrl}" class="rsa-btn rsa-book">
                                <i class="fa-solid fa-calendar-check"></i> Đặt phòng
                            </a>`;
                        card.appendChild(actions);
                        cardsWrap.appendChild(card);
                    });
                    bubble.appendChild(cardsWrap);
                }

                wrapper.appendChild(avatar);
                wrapper.appendChild(bubble);
                messages.appendChild(wrapper);
                scrollToBottom();
            }

            // ── Format message text (simple markdown) ──
            function formatMessage(text) {
                return text
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/\n/g, '<br>');
            }

            // ── Typing indicator ──
            function showTyping() {
                const div = document.createElement('div');
                div.className = 'chat-msg ai';
                div.id = 'typingIndicator';
                div.innerHTML = `
                    <div class="msg-avatar ai"><i class="fa-solid fa-robot"></i></div>
                    <div class="typing-indicator">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>`;
                messages.appendChild(div);
                scrollToBottom();
            }
            function hideTyping() {
                const el = document.getElementById('typingIndicator');
                if (el) el.remove();
            }

            // ── Send message ──
            async function sendMessage() {
                const text = input.value.trim();
                if (!text || isLoading) return;

                isLoading = true;
                sendBtn.disabled = true;
                quickChips.style.display = 'none';

                input.value = '';
                input.style.height = 'auto';

                appendMessage('user', text, []);
                chatHistory.push({ role: 'user', content: text });
                showTyping();

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const headers = { 'Content-Type': 'application/json' };
                    if (token) headers['RequestVerificationToken'] = token;

                    const resp = await fetch('/Chat?handler=Send', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify({ message: text, history: chatHistory.slice(-8) })
                    });

                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    const data = await resp.json();

                    hideTyping();
                    appendMessage('ai', data.message || 'Xin lỗi, tôi không thể trả lời lúc này.', data.suggestedRooms || []);
                    chatHistory.push({ role: 'assistant', content: data.message || '' });

                } catch (err) {
                    hideTyping();
                    appendMessage('ai', '⚠️ Đã có lỗi xảy ra. Vui lòng thử lại sau.', []);
                } finally {
                    isLoading = false;
                    sendBtn.disabled = false;
                    input.focus();
                }
            }
        })();
    </script>
</body>
</html>