@page
@model HotelManagementRazorPage.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Tìm kiếm phòng";
}

<style>
    :root {
        --primary:#1565C0; --primary-d:#0D47A1; --primary-l:#1976D2;
        --accent:#42A5F5; --white:#FFFFFF;
        --gray-50:#F8FAFF; --gray-100:#EFF4FF; --gray-200:#DBEAFE;
        --text:#1E293B; --text-sub:#64748B;
    }

    .search-hero {
        background: linear-gradient(135deg, var(--primary-d) 0%, var(--primary) 60%, var(--primary-l) 100%);
        padding: 3rem 0 5rem;
    }
    .search-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        color: #fff; font-weight: 700; margin-bottom: .5rem;
    }
    .search-hero p { color: rgba(255,255,255,.8); font-size: 1rem; }

    .search-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(21,101,192,.18);
        padding: 2rem 2.5rem;
        margin-top: -60px;
        position: relative;
        z-index: 10;
    }
    .search-card .form-label {
        font-size: .72rem; font-weight: 700;
        letter-spacing: 1px; text-transform: uppercase;
        color: var(--primary); margin-bottom: .4rem;
    }
    .search-card .form-control,
    .search-card .form-select {
        border: 1.5px solid #CBD5E1; border-radius: 8px;
        padding: .65rem .9rem; font-size: .9rem; color: var(--text);
        transition: border-color .2s, box-shadow .2s;
    }
    .search-card .form-control:focus,
    .search-card .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(21,101,192,.12);
        outline: none;
    }
    .btn-search {
        background: var(--primary); color: var(--white);
        font-weight: 700; padding: .72rem 1.5rem;
        border-radius: 8px; border: none; width: 100%;
        font-size: .92rem; transition: all .25s;
        display: flex; align-items: center; justify-content: center; gap: .5rem;
    }
    .btn-search:hover { background: var(--primary-d); transform: translateY(-1px); }

    /* ── ROOM CARD ── */
    .room-card {
        background: var(--white); border-radius: 14px;
        overflow: hidden; border: 1px solid #E2EAF4;
        transition: all .35s; height: 100%;
        box-shadow: 0 2px 12px rgba(21,101,192,.06);
    }
    .room-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(21,101,192,.14); border-color: var(--accent); }
    .room-img { position: relative; height: 210px; overflow: hidden; }
    .room-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
    .room-card:hover .room-img img { transform: scale(1.06); }
    .badge-avail { position: absolute; top: 12px; left: 12px; padding: .25rem .7rem; border-radius: 20px; font-size: .7rem; font-weight: 700; letter-spacing: .5px; }
    .badge-avail.yes { background: #1565C0; color: #fff; }
    .badge-avail.no  { background: #EF4444; color: #fff; }
    .room-body { padding: 1.4rem; }
    .room-type-tag { font-size: .7rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-bottom: .35rem; }
    .room-name { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
    .room-desc { font-size: .83rem; color: var(--text-sub); line-height: 1.6; margin-bottom: .9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .room-meta { display: flex; gap: 1rem; align-items: center; font-size: .8rem; color: var(--text-sub); padding: .9rem 0; border-top: 1px solid var(--gray-100); border-bottom: 1px solid var(--gray-100); margin-bottom: .9rem; }
    .room-meta i { color: var(--primary); }
    .room-foot { display: flex; align-items: center; justify-content: space-between; }
    .room-price-num { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: var(--primary); }
    .room-price-unit { font-size: .75rem; color: var(--text-sub); }
    .btn-book { background: var(--primary); color: var(--white) !important; font-size: .82rem; font-weight: 600; padding: .45rem 1.1rem; border-radius: 8px; text-decoration: none; transition: all .25s; display: inline-flex; align-items: center; gap: .4rem; }
    .btn-book:hover { background: var(--primary-d); transform: translateY(-1px); }
    .empty-state { text-align: center; padding: 4rem 1rem; color: var(--text-sub); }
    .empty-state i { font-size: 3rem; color: var(--gray-200); display: block; margin-bottom: 1rem; }

    /* ── STAR RATING ── */
    .room-stars { display: flex; align-items: center; gap: .35rem; margin-bottom: .65rem; }
    .star-wrap  { display: flex; gap: 2px; }
    .star-wrap i.filled { color: #F59E0B; font-size: .85rem; }
    .star-wrap i.half   { color: #F59E0B; font-size: .85rem; }
    .star-wrap i.empty  { color: #D2D2D7; font-size: .85rem; }
    .star-avg   { font-size: .8rem; font-weight: 700; color: var(--text); }
    .star-count { font-size: .75rem; color: var(--text-sub); }
    .star-none  { font-size: .75rem; color: var(--text-sub); font-style: italic; }
</style>

<!-- ═══ SEARCH HERO ═══ -->
<section class="search-hero">
    <div class="container">
        <h1><i class="fa-solid fa-magnifying-glass me-2"></i>Tìm kiếm phòng</h1>
        <p>Chọn ngày và loại phòng để tìm phòng phù hợp nhất với bạn</p>
    </div>
</section>

<!-- ═══ SEARCH CARD ═══ -->
<section class="pb-5" style="background: var(--gray-50);">
    <div class="container">
        <div class="search-card mb-5">
            <form method="get" asp-page="/Rooms/Index">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label">Ngày nhận phòng</label>
                        <input type="date" name="CheckIn"
                               value="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label">Ngày trả phòng</label>
                        <input type="date" name="CheckOut"
                               value="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                               class="form-control"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label">Loại phòng</label>
                        <select name="SelectedRoomTypeId" class="form-select">
                            <option value="">Tất cả loại phòng</option>
                            @foreach (var rt in Model.RoomTypes)
                            {
                                <option value="@rt.Id" selected="@(Model.SelectedRoomTypeId == rt.Id ? "selected" : null)">@rt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <button type="submit" class="btn-search">
                            <i class="fa-solid fa-search"></i>Tìm phòng trống
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Result heading -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-0">
                    @if (Model.IsSearching)
                    {
                        <span><i class="fa-solid fa-list-check me-2" style="color:var(--primary)"></i>Kết quả tìm kiếm</span>
                    }
                    else
                    {
                        <span><i class="fa-solid fa-hotel me-2" style="color:var(--primary)"></i>Tất cả phòng</span>
                    }
                </h4>
                <p class="text-muted mb-0" style="font-size:.85rem;">
                    Tìm thấy <strong>@Model.Rooms.Count</strong> phòng
                    @if (Model.CheckIn.HasValue && Model.CheckOut.HasValue)
                    {
                        <span>từ @Model.CheckIn.Value.ToString("dd/MM/yyyy") đến @Model.CheckOut.Value.ToString("dd/MM/yyyy")</span>
                    }
                </p>
            </div>
            @if (Model.IsSearching)
            {
                <a asp-page="/Rooms/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-rotate-left me-1"></i>Xóa bộ lọc
                </a>
            }
        </div>

        <!-- Rooms grid -->
        @if (!Model.Rooms.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-bed"></i>
                <p>Không tìm thấy phòng phù hợp.<br>Vui lòng thử lại với ngày khác hoặc loại phòng khác.</p>
                <a asp-page="/Rooms/Index" class="btn btn-primary mt-2">Xem tất cả phòng</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-img">
                                @{
                                    var fallback = "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80";
                                }
                                <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? fallback : room.ImageUrl)"
                                     alt="Phòng @room.RoomNumber" onerror="this.src='@fallback'" />
                                @{
                                    bool avail = room.Status == BusinessObjects.Enums.RoomStatus.Available;
                                }
                                <span class="badge-avail @(avail ? "yes" : "no")">
                                    <i class="fa-solid @(avail ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                                    @(avail ? "Còn phòng" : "Đã đặt")
                                </span>
                            </div>
                            <div class="room-body">
                                <div class="room-type-tag">@(room.RoomType?.Name ?? "Phòng")</div>
                                <div class="room-name">Phòng @room.RoomNumber</div>
                                <div class="room-desc">
                                    @(string.IsNullOrEmpty(room.Description)
                                        ? "Phòng tiện nghi đầy đủ, thiết kế hiện đại mang lại sự thoải mái tuyệt vời."
                                        : room.Description)
                                </div>
                                @{
                                    bool hasRating = Model.RoomRatings.TryGetValue(room.Id, out var rating);
                                    double avg = hasRating ? rating.Avg : 0;
                                    int rCount = hasRating ? rating.Count : 0;
                                }
                                <div class="room-stars">
                                    @if (hasRating)
                                    {
                                        <div class="star-wrap">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                if (avg >= s)
                                                {
                                                    <i class="fa-solid fa-star filled"></i>
                                                }
                                                else if (avg >= s - 0.5)
                                                {
                                                    <i class="fa-solid fa-star-half-stroke half"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-star empty"></i>
                                                }
                                            }
                                        </div>
                                        <span class="star-avg">@avg.ToString("0.0")</span>
                                        <span class="star-count">(@rCount đánh giá)</span>
                                    }
                                    else
                                    {
                                        <span class="star-none">Chưa có đánh giá</span>
                                    }
                                </div>
                                <div class="room-meta">
                                    <span><i class="fa-solid fa-users me-1"></i>@room.MaxOccupancy khách</span>
                                    @if (room.RoomType != null)
                                    {
                                        <span><i class="fa-solid fa-layer-group me-1"></i>@room.RoomType.Name</span>
                                    }
                                </div>
                                <div class="room-foot">
                                    <div>
                                        <div class="room-price-num">@((room.RoomType?.PricePerNight ?? 0).ToString("N0"))₫</div>
                                        <div class="room-price-unit">/ đêm</div>
                                    </div>
                                    <div style="display:flex;gap:.4rem;">
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id"
                                           class="btn-book" style="background:var(--white);color:var(--primary)!important;border:1.5px solid var(--primary);">
                                            <i class="fa-solid fa-eye"></i>Chi tiết
                                        </a>
                                        <a asp-page="/Rooms/Detail" asp-route-id="@room.Id" class="btn-book">
                                            <i class="fa-solid fa-calendar-check"></i>Đặt phòng
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const roomConn = new signalR.HubConnectionBuilder()
            .withUrl("/roomHub")
            .withAutomaticReconnect()
            .build();

        roomConn.on("ReceiveRoomUpdate", function (action, roomNumber) {
            window.location.reload();
        });

        roomConn.start().catch(err => console.error("SignalR room error:", err));
    </script>
}
