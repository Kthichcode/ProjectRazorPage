@page "{id:int}"
@model HotelManagementRazorPage.Pages.Manager.Rooms.DeleteModel
@{
    ViewData["Title"] = "Xóa phòng";
    Layout = "/Pages/Manager/_ManagerLayout.cshtml";
}

<div class="page-header">
    <h1><i class="fa-solid fa-trash me-2" style="color:#EF4444"></i>Xóa phòng</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Manager/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-page="/Manager/Rooms/Index">Phòng</a></li>
            <li class="breadcrumb-item active">Xóa phòng</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header" style="border-bottom-color:#FECACA;">
                <h5 style="color:#DC2626;"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa phòng</h5>
            </div>
            <div class="admin-card-body">
                <div class="admin-alert admin-alert-danger mb-3">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    Thao tác này không thể hoàn tác. Phòng sẽ bị xóa vĩnh viễn khỏi hệ thống.
                </div>

                @if (Model.Room != null)
                {
                    <div style="background:#F8FAFF;border:1.5px solid #D1FAE5;border-radius:10px;padding:1.2rem;margin-bottom:1.5rem;">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="admin-form-label">Số phòng</div>
                                <div style="font-weight:700;font-size:1.1rem;color:var(--primary);">Phòng @Model.Room.RoomNumber</div>
                            </div>
                            <div class="col-6">
                                <div class="admin-form-label">Loại phòng</div>
                                <div>@(Model.Room.RoomType?.Name ?? "—")</div>
                            </div>
                            <div class="col-6">
                                <div class="admin-form-label">Trạng thái</div>
                                <div>
                                    @if (Model.Room.Status == BusinessObjects.Enums.RoomStatus.Available)
                                    {
                                        <span class="status-badge badge-available">Còn trống</span>
                                    }
                                    else if (Model.Room.Status == BusinessObjects.Enums.RoomStatus.Maintenance)
                                    {
                                        <span class="status-badge badge-maintenance">Bảo trì</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-occupied">Đang có khách</span>
                                    }
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="admin-form-label">Sức chứa</div>
                                <div>@Model.Room.MaxOccupancy khách</div>
                            </div>
                        </div>
                    </div>
                }

                <form method="post">
                    <input type="hidden" asp-for="RoomId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-admin-primary" style="background:#DC2626;flex:1;justify-content:center;">
                            <i class="fa-solid fa-trash"></i> Xác nhận xóa
                        </button>
                        <a asp-page="/Manager/Rooms/Index" class="btn-admin-sm btn-edit" style="flex:1;justify-content:center;padding:.5rem;">
                            <i class="fa-solid fa-xmark"></i> Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
