<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manager | Mường Thanh Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --blue:       #0066CC;
            --blue-dark:  #004FA3;
            --blue-dim:   #E8F0FE;
            --blue-mid:   #D0E4FF;
            --divider:    #D2D2D7;
            --bg:         #FFFFFF;
            --bg-alt:     #F5F5F7;
            --text:       #1D1D1F;
            --text-sub:   #6E6E73;
            --sidebar-w:  240px;
            --topbar-h:   56px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-alt);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        /* ── SIDEBAR ── */
        .mgr-sidebar {
            position: fixed;
            left: 0; top: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--bg);
            border-right: 1px solid var(--divider);
            display: flex;
            flex-direction: column;
            z-index: 200;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 0 1.4rem;
            border-bottom: 1px solid var(--divider);
            text-decoration: none;
        }
        .sidebar-brand-icon {
            width: 30px; height: 30px;
            background: var(--blue);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: .85rem;
            flex-shrink: 0;
        }
        .sidebar-brand-txt  { font-size: .88rem; font-weight: 700; color: var(--text); line-height: 1.2; }
        .sidebar-brand-role { font-size: .67rem; color: var(--blue); font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }

        .sidebar-nav { flex: 1; overflow-y: auto; padding: 1rem 0; }
        .sidebar-section { font-size:.63rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--text-sub); padding:.9rem 1.4rem .35rem; opacity:.7; }

        .sidebar-link {
            display: flex; align-items: center; gap: .75rem;
            padding: .6rem 1.4rem;
            color: var(--text-sub); text-decoration: none;
            font-size: .845rem; font-weight: 500;
            position: relative;
            transition: color .15s, background .15s;
        }
        .sidebar-link::before {
            content: '';
            position: absolute;
            left: 0; top: 20%; bottom: 20%;
            width: 3px; border-radius: 0 3px 3px 0;
            background: var(--blue); opacity: 0;
            transition: opacity .15s;
        }
        .sidebar-link:hover { color: var(--text); background: var(--bg-alt); }
        .sidebar-link.active { color: var(--blue); background: var(--blue-dim); font-weight: 600; }
        .sidebar-link.active::before { opacity: 1; }
        .sidebar-link i { width: 18px; text-align: center; font-size: .85rem; }

        /* Badge for pending counts */
        .nav-badge {
            margin-left: auto;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 9px;
            background: #FF3B30;
            color: #fff;
            font-size: .62rem;
            font-weight: 700;
            display: flex; align-items: center; justify-content: center;
        }

        .sidebar-footer { padding: 1rem 1.4rem; border-top: 1px solid var(--divider); }
        .btn-sidebar-logout {
            display: flex; align-items: center; gap: .6rem;
            width: 100%; padding: .55rem 1rem;
            background: none; border: 1px solid var(--divider);
            border-radius: 8px; color: var(--text-sub);
            font-size: .82rem; font-weight: 500;
            cursor: pointer; transition: all .2s;
        }
        .btn-sidebar-logout:hover { border-color: #C0392B; color: #C0392B; background: #FFF5F5; }

        /* ── TOPBAR ── */
        .mgr-topbar {
            position: fixed;
            left: var(--sidebar-w); top: 0; right: 0;
            height: var(--topbar-h);
            background: var(--bg);
            border-bottom: 1px solid var(--divider);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 2rem;
            z-index: 100;
        }
        .topbar-title { font-size: .92rem; font-weight: 600; color: var(--text); }
        .topbar-right  { display: flex; align-items: center; gap: .75rem; }
        .topbar-avatar {
            width: 32px; height: 32px;
            background: var(--blue); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: .78rem; font-weight: 700;
        }
        .topbar-name { font-size: .845rem; font-weight: 600; color: var(--text); }

        /* ── MAIN ── */
        .mgr-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 2rem 2.2rem;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── PAGE HEADER ── */
        .page-title { font-size: 1.4rem; font-weight: 700; color: var(--text); letter-spacing: -.3px; }
        .page-sub   { font-size: .8rem; color: var(--text-sub); margin-top: .2rem; }

        /* ── CARDS ── */
        .mgr-card {
            background: var(--bg);
            border: 1px solid var(--divider);
            border-radius: 14px;
            overflow: hidden;
        }
        .mgr-card-header {
            padding: 1rem 1.4rem;
            border-bottom: 1px solid var(--divider);
            display: flex; align-items: center; justify-content: space-between;
        }
        .mgr-card-header h5 { font-size: .9rem; font-weight: 700; color: var(--text); margin: 0; }
        .mgr-card-body { padding: 1.4rem; }

        /* ── STAT CARDS ── */
        .stat-card {
            background: var(--bg);
            border: 1px solid var(--divider);
            border-radius: 14px;
            padding: 1.4rem;
            transition: box-shadow .25s, transform .25s;
        }
        .stat-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.08); transform: translateY(-2px); }
        .stat-card-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }
        .stat-card-value { font-size: 2rem; font-weight: 700; color: var(--text); line-height: 1; margin-bottom: .25rem; }
        .stat-card-label { font-size: .75rem; color: var(--text-sub); font-weight: 500; }

        /* Highlight card (blue) */
        .stat-card.highlight {
            background: var(--blue);
            border-color: transparent;
        }
        .stat-card.highlight .stat-card-value,
        .stat-card.highlight .stat-card-label { color: rgba(255,255,255,.9); }
        .stat-card.highlight .stat-card-icon { background: rgba(255,255,255,.15); }

        /* Alert card (refund) */
        .stat-card.alert-card {
            background: #FFF8F0;
            border-color: #F59E0B;
        }
        .stat-card.alert-card .stat-card-value { color: #92400E; }
        .stat-card.alert-card .stat-card-label { color: #B45309; }

        /* ── TABLE ── */
        .mgr-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .mgr-table thead th {
            background: var(--bg-alt); color: var(--text-sub);
            font-size: .67rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            padding: .9rem 1.1rem;
            border-bottom: 1px solid var(--divider);
        }
        .mgr-table thead th:first-child { padding-left: 1.4rem; }
        .mgr-table thead th:last-child  { padding-right: 1.4rem; }
        .mgr-table tbody td {
            padding: .95rem 1.1rem;
            border-bottom: 1px solid var(--bg-alt);
            font-size: .855rem;
            vertical-align: middle;
        }
        .mgr-table tbody td:first-child { padding-left: 1.4rem; }
        .mgr-table tbody td:last-child  { padding-right: 1.4rem; }
        .mgr-table tbody tr:hover { background: var(--bg-alt); }
        .mgr-table tbody tr:last-child td { border-bottom: none; }

        /* ── BUTTONS ── */
        .btn-mgr-primary {
            background: var(--blue); color: #fff !important;
            border: none; border-radius: 8px;
            padding: .52rem 1.2rem;
            font-size: .845rem; font-weight: 600;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: .4rem;
            cursor: pointer; transition: all .2s;
        }
        .btn-mgr-primary:hover { background: var(--blue-dark); transform: translateY(-1px); }

        .btn-mgr-sm {
            padding: .3rem .75rem; font-size: .775rem; border-radius: 6px;
            font-weight: 600; text-decoration: none;
            display: inline-flex; align-items: center; gap: .3rem;
            cursor: pointer; transition: all .2s; border: none;
        }
        .btn-view   { background: var(--blue-dim); color: var(--blue); }
        .btn-view:hover { background: var(--blue-mid); }
        .btn-edit   { background: var(--bg-alt); color: var(--text-sub); border: 1px solid var(--divider); }
        .btn-edit:hover { background: var(--divider); color: var(--text); }
        .btn-delete { background: #FEF2F2; color: #DC2626; }
        .btn-delete:hover { background: #FEE2E2; }
        .btn-warn   { background: #FEF3C7; color: #92400E; }
        .btn-warn:hover { background: #FDE68A; }

        /* ── STATUS BADGES ── */
        .status-badge {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .28rem .7rem; border-radius: 980px;
            font-size: .67rem; font-weight: 700; letter-spacing: .3px;
        }
        .status-badge::before {
            content: ''; width: 5px; height: 5px; border-radius: 50%;
        }
        .badge-pending        { background: #FEF3C7; color: #92400E; }
        .badge-pending::before        { background: #D97706; }
        .badge-confirmed      { background: var(--blue-dim); color: var(--blue-dark); }
        .badge-confirmed::before      { background: var(--blue); }
        .badge-checkedin      { background: #DCFCE7; color: #166534; }
        .badge-checkedin::before      { background: #16A34A; }
        .badge-completed      { background: #F3F4F6; color: #374151; }
        .badge-completed::before      { background: #6B7280; }
        .badge-cancelled      { background: #FEE2E2; color: #991B1B; }
        .badge-cancelled::before      { background: #DC2626; }
        .badge-available      { background: var(--blue-dim); color: var(--blue); }
        .badge-available::before      { background: var(--blue); }
        .badge-cancelpending  { background: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; }
        .badge-cancelpending::before  { background: #F59E0B; }

        /* ── FORM ── */
        .admin-form-label {
            font-size: .68rem; font-weight: 700; letter-spacing: 1.5px;
            text-transform: uppercase; color: var(--text-sub); margin-bottom: .4rem; display: block;
        }
        .admin-form-control {
            border: 1px solid var(--divider); border-radius: 8px;
            padding: .58rem .9rem; font-size: .855rem;
            width: 100%; color: var(--text); background: var(--bg-alt);
            outline: none; transition: border-color .2s, box-shadow .2s;
            font-family: 'Inter', sans-serif;
        }
        .admin-form-control:focus {
            border-color: var(--blue); background: var(--bg);
            box-shadow: 0 0 0 3px rgba(0,102,204,.1);
        }

        /* ── ALERTS ── */
        .mgr-alert {
            display: flex; align-items: center; gap: .75rem;
            padding: .85rem 1.2rem; border-radius: 10px;
            font-size: .855rem; font-weight: 500; margin-bottom: 1.4rem;
        }
        .mgr-alert-success { background: #EBF8F2; border: 1px solid #A7EBC7; color: #1A6640; }
        .mgr-alert-danger  { background: #FEF2F2; border: 1px solid #FCA5A5; color: #991B1B; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .mgr-sidebar { transform: translateX(-100%); }
            .mgr-sidebar.open { transform: translateX(0); }
            .mgr-topbar, .mgr-main { left: 0; margin-left: 0; }
        }

        @RenderSection("AdminStyles", required: false)

        /* ── BACKWARD COMPATIBILITY (Details.cshtml uses these) ── */
        :root {
            --primary:   var(--blue);
            --primary-d: var(--blue-dark);
            --gray-50:   var(--bg-alt);
            --gray-100:  var(--blue-dim);
            --text-sub:  #6E6E73;
            --white:     #FFFFFF;
        }
        /* admin-card → mgr-card */
        .admin-card { background:var(--bg); border:1px solid var(--divider); border-radius:14px; overflow:hidden; }
        .admin-card-header { padding:1rem 1.4rem; border-bottom:1px solid var(--divider); display:flex; align-items:center; justify-content:space-between; }
        .admin-card-header h5 { font-size:.9rem; font-weight:700; color:var(--text); margin:0; }
        .admin-card-body { padding:1.4rem; }
        /* admin-alert → mgr-alert */
        .admin-alert { display:flex; align-items:center; gap:.75rem; padding:.85rem 1.2rem; border-radius:10px; font-size:.855rem; font-weight:500; margin-bottom:1.4rem; }
        .admin-alert-success { background:#EBF8F2; border:1px solid #A7EBC7; color:#1A6640; }
        .admin-alert-danger  { background:#FEF2F2; border:1px solid #FCA5A5; color:#991B1B; }
        /* btn-admin-primary → btn-mgr-primary */
        .btn-admin-primary { background:var(--blue); color:#fff!important; border:none; border-radius:8px; padding:.52rem 1.2rem; font-size:.845rem; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:.4rem; cursor:pointer; transition:all .2s; }
        .btn-admin-primary:hover { background:var(--blue-dark); }
        /* admin-table → mgr-table */
        .admin-table { width:100%; border-collapse:separate; border-spacing:0; }
        .admin-table thead th { background:var(--bg-alt); color:var(--text-sub); font-size:.67rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; padding:.9rem 1.1rem; border-bottom:1px solid var(--divider); }
        .admin-table tbody td { padding:.95rem 1.1rem; border-bottom:1px solid var(--bg-alt); font-size:.855rem; vertical-align:middle; }
        .admin-table tbody tr:hover { background:var(--bg-alt); }
        .admin-table tbody tr:last-child td { border-bottom:none; }
        /* admin form */
        .admin-form-label { font-size:.68rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-sub); margin-bottom:.4rem; display:block; }
        .admin-form-control { border:1px solid var(--divider); border-radius:8px; padding:.58rem .9rem; font-size:.855rem; width:100%; color:var(--text); background:var(--bg-alt); outline:none; transition:border-color .2s; font-family:'Inter',sans-serif; }
        .admin-form-control:focus { border-color:var(--blue); background:var(--bg); box-shadow:0 0 0 3px rgba(0,102,204,.1); }
        /* page-header breadcrumb */
        .page-header { margin-bottom:1.8rem; }
        .page-header h1 { font-size:1.4rem; font-weight:700; color:var(--text); margin-bottom:.25rem; }
    </style>
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="mgr-sidebar" id="mgrSidebar">
        <a class="sidebar-brand" asp-page="/Manager/Index">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-user-tie"></i>
            </div>
            <div>
                <div class="sidebar-brand-txt">Mường Thanh</div>
                <div class="sidebar-brand-role">Quản lý</div>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="sidebar-section">Tổng quan</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Manager/Index" ? "active" : "")"
               asp-page="/Manager/Index">
                <i class="fa-solid fa-chart-pie"></i> Dashboard
            </a>

            <div class="sidebar-section">Vận hành</div>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Manager/Bookings") == true ? "active" : "")"
               asp-page="/Manager/Bookings/Index">
                <i class="fa-solid fa-calendar-check"></i> Đặt phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Manager/Rooms") == true ? "active" : "")"
               asp-page="/Manager/Rooms/Index">
                <i class="fa-solid fa-bed"></i> Quản lý phòng
            </a>
            <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Manager/Reviews" ? "active" : "")"
               asp-page="/Manager/Reviews">
                <i class="fa-solid fa-star"></i> Duyệt bình luận
            </a>

            <div class="sidebar-section">Hệ thống</div>
            <a class="sidebar-link" asp-page="/Index">
                <i class="fa-solid fa-house"></i> Về trang chủ
            </a>
        </nav>

        <div class="sidebar-footer">
            <form asp-page="/Account/Logout" method="post" class="m-0">
                <button type="submit" class="btn-sidebar-logout">
                    <i class="fa-solid fa-right-from-bracket"></i>Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- TOPBAR -->
    <header class="mgr-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="d-lg-none btn border-0 p-1"
                    onclick="document.getElementById('mgrSidebar').classList.toggle('open')">
                <i class="fa-solid fa-bars" style="color:var(--blue);"></i>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>
        </div>
        <div class="topbar-right">
            <div class="topbar-avatar">
                @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "M")
            </div>
            <span class="topbar-name d-none d-sm-inline">@User.Identity?.Name</span>
        </div>
    </header>

    <!-- MAIN -->
    <main class="mgr-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
