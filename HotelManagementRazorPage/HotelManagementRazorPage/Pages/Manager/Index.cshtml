@page
@model HotelManagementRazorPage.Pages.Manager.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Pages/Manager/_ManagerLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Dashboard Quản lý</div>
        <div class="page-sub">Tổng quan vận hành · @DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
    </div>
    <a asp-page="/Manager/Bookings/Index" class="btn-mgr-primary">
        <i class="fa-solid fa-calendar-check"></i> Xem tất cả đặt phòng
    </a>
</div>

<!-- STAT CARDS ROW 1 -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:var(--blue-dim);">
                <i class="fa-solid fa-calendar-plus" style="color:var(--blue);"></i>
            </div>
            <div class="stat-card-value">@Model.Data.BookingsToday</div>
            <div class="stat-card-label">Đặt phòng hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#DCFCE7;">
                <i class="fa-solid fa-door-open" style="color:#16A34A;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.CheckInsToday</div>
            <div class="stat-card-label">Check-In hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#FEF3C7;">
                <i class="fa-solid fa-door-closed" style="color:#D97706;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.CheckOutsToday</div>
            <div class="stat-card-label">Check-Out hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card highlight">
            <div class="stat-card-icon">
                <i class="fa-solid fa-bed" style="color:#fff;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.CurrentlyCheckedIn</div>
            <div class="stat-card-label">Đang có khách lưu trú</div>
        </div>
    </div>
</div>

<!-- STAT CARDS ROW 2 (pending actions) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Manager/Bookings/Index" asp-route-status="1" style="text-decoration:none;">
            <div class="stat-card" style="border-color:@(Model.Data.PendingCount > 0 ? "#F59E0B" : "var(--divider)");background:@(Model.Data.PendingCount > 0 ? "#FFFBEB" : "var(--bg)");">
                <div class="stat-card-icon" style="background:#FEF3C7;">
                    <i class="fa-solid fa-clock" style="color:#D97706;"></i>
                </div>
                <div class="stat-card-value" style="color:@(Model.Data.PendingCount > 0 ? "#92400E" : "var(--text)");">@Model.Data.PendingCount</div>
                <div class="stat-card-label" style="color:#B45309;">Chờ xác nhận</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-page="/Manager/Bookings/Index" asp-route-status="6" style="text-decoration:none;">
            <div class="stat-card" style="border-color:@(Model.Data.CancellationPendingCount > 0 ? "#EF4444" : "var(--divider)");background:@(Model.Data.CancellationPendingCount > 0 ? "#FFF5F5" : "var(--bg)");">
                <div class="stat-card-icon" style="background:#FEE2E2;">
                    <i class="fa-solid fa-rotate-left" style="color:#DC2626;"></i>
                </div>
                <div class="stat-card-value" style="color:@(Model.Data.CancellationPendingCount > 0 ? "#991B1B" : "var(--text)");">@Model.Data.CancellationPendingCount</div>
                <div class="stat-card-label" style="color:#B91C1C;">Chờ duyệt hoàn tiền</div>
            </div>
        </a>
    </div>
</div>

<!-- TABLES ROW -->
<div class="row g-3 mb-3">
    <!-- Pending bookings -->
    <div class="col-lg-6">
        <div class="mgr-card h-100">
            <div class="mgr-card-header">
                <h5><i class="fa-solid fa-clock me-2" style="color:#D97706;"></i>Chờ xác nhận (@Model.Data.PendingCount)</h5>
                <a asp-page="/Manager/Bookings/Index" asp-route-status="1" class="btn-mgr-sm btn-view">Xem tất cả</a>
            </div>
            @if (!Model.Data.PendingBookings.Any())
            {
                <div class="text-center py-5" style="color:var(--text-sub);">
                    <i class="fa-solid fa-circle-check fa-2x mb-2 d-block" style="color:var(--divider);"></i>
                    Không có booking nào đang chờ
                </div>
            }
            else
            {
                <table class="mgr-table">
                    <thead>
                        <tr>
                            <th>Mã</th><th>Khách hàng</th><th>Nhận phòng</th><th>Tổng tiền</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Data.PendingBookings.Take(5))
                        {
                            <tr>
                                <td><span style="font-weight:700;color:var(--blue);">#@b.Id</span></td>
                                <td>
                                    <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                    <div style="font-size:.73rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                                </td>
                                <td style="font-size:.82rem;">@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                                <td style="font-weight:700;color:var(--blue);font-size:.82rem;">@b.TotalAmount.ToString("N0")₫</td>
                                <td>
                                    <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id" class="btn-mgr-sm btn-view">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Refund pending -->
    <div class="col-lg-6">
        <div class="mgr-card h-100">
            <div class="mgr-card-header">
                <h5><i class="fa-solid fa-rotate-left me-2" style="color:#DC2626;"></i>Chờ duyệt hoàn tiền (@Model.Data.CancellationPendingCount)</h5>
                <a asp-page="/Manager/Bookings/Index" asp-route-status="6" class="btn-mgr-sm btn-view">Xem tất cả</a>
            </div>
            @if (!Model.Data.CancellationPendingBookings.Any())
            {
                <div class="text-center py-5" style="color:var(--text-sub);">
                    <i class="fa-solid fa-circle-check fa-2x mb-2 d-block" style="color:var(--divider);"></i>
                    Không có yêu cầu hoàn tiền nào
                </div>
            }
            else
            {
                <table class="mgr-table">
                    <thead>
                        <tr>
                            <th>Mã</th><th>Khách hàng</th><th>Nhận phòng</th><th>Tổng tiền</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Data.CancellationPendingBookings.Take(5))
                        {
                            <tr>
                                <td><span style="font-weight:700;color:#DC2626;">#@b.Id</span></td>
                                <td>
                                    <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                    <div style="font-size:.73rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                                </td>
                                <td style="font-size:.82rem;">@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                                <td style="font-weight:700;color:#DC2626;font-size:.82rem;">@b.TotalAmount.ToString("N0")₫</td>
                                <td>
                                    <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id" class="btn-mgr-sm btn-warn">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- Check-in today -->
<div class="row g-3">
    <div class="col-12">
        <div class="mgr-card">
            <div class="mgr-card-header">
                <h5><i class="fa-solid fa-right-to-bracket me-2" style="color:var(--blue);"></i>Check-In hôm nay (@Model.Data.CheckIngToday.Count)</h5>
            </div>
            @if (!Model.Data.CheckIngToday.Any())
            {
                <div class="text-center py-5" style="color:var(--text-sub);">
                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block" style="color:var(--divider);"></i>
                    Không có khách check-in hôm nay
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="mgr-table">
                        <thead>
                            <tr>
                                <th>Mã</th><th>Khách hàng</th><th>Phòng</th><th>Check-Out</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Data.CheckIngToday)
                            {
                                <tr>
                                    <td><span style="font-weight:700;color:var(--blue);">#@b.Id</span></td>
                                    <td>
                                        <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                        <div style="font-size:.73rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var br in b.BookingRooms)
                                            {
                                                <span class="status-badge badge-available">@br.Room?.RoomNumber</span>
                                            }
                                        </div>
                                    </td>
                                    <td style="font-size:.82rem;">@b.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id" class="btn-mgr-sm btn-view">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
