@page
@model HotelManagementRazorPage.Pages.Manager.IndexModel
@{
    ViewData["Title"] = "Dashboard Quản lý";
    Layout = "/Pages/Manager/_ManagerLayout.cshtml";
}

<div class="page-header">
    <h1><i class="fa-solid fa-chart-pie me-2" style="color:var(--primary)"></i>Dashboard Quản lý</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Tổng quan vận hành</li>
        </ol>
    </nav>
</div>

<!-- ── STAT CARDS ── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#ECFDF5;">
                <i class="fa-solid fa-calendar-plus" style="color:#0D7055;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.BookingsToday</div>
            <div class="stat-card-label">Đặt phòng hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#F0FDF4;">
                <i class="fa-solid fa-door-open" style="color:#16A34A;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.CheckInsToday</div>
            <div class="stat-card-label">Check-In hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#FFF7ED;">
                <i class="fa-solid fa-door-closed" style="color:#C2410C;"></i>
            </div>
            <div class="stat-card-value">@Model.Data.CheckOutsToday</div>
            <div class="stat-card-label">Check-Out hôm nay</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#085C44,#0D7055);border-color:transparent;">
            <div class="stat-card-icon" style="background:rgba(255,255,255,.15);">
                <i class="fa-solid fa-bed" style="color:#fff;"></i>
            </div>
            <div class="stat-card-value" style="color:#fff;">@Model.Data.CurrentlyCheckedIn</div>
            <div class="stat-card-label" style="color:rgba(255,255,255,.75);">Đang có khách</div>
        </div>
    </div>
</div>

<!-- ── PENDING & CHECK-IN TABLES ── -->
<div class="row g-3">
    <!-- Pending Bookings -->
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h5><i class="fa-solid fa-clock me-2" style="color:#C2410C;"></i>Chờ xác nhận (@Model.Data.PendingCount)</h5>
                <a asp-page="/Manager/Bookings/Index" asp-route-status="1" class="btn-admin-sm btn-edit">Xem tất cả</a>
            </div>
            <div class="admin-card-body p-0">
                @if (!Model.Data.PendingBookings.Any())
                {
                    <div class="text-center py-4" style="color:var(--text-sub);">
                        <i class="fa-solid fa-circle-check fa-2x mb-2 d-block" style="color:#BBF7D0;"></i>
                        Không có booking nào đang chờ
                    </div>
                }
                else
                {
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Khách hàng</th>
                                <th>Nhận phòng</th>
                                <th>Tổng tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Data.PendingBookings.Take(5))
                            {
                                <tr>
                                    <td><span style="font-weight:700;color:var(--primary);">#@b.Id</span></td>
                                    <td>
                                        <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                        <div style="font-size:.73rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                                    </td>
                                    <td>@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                                    <td style="font-weight:700;color:var(--primary);">@b.TotalAmount.ToString("N0")₫</td>
                                    <td>
                                        <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id"
                                           class="btn-admin-sm btn-view">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Check-In Today -->
    <div class="col-lg-6">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h5><i class="fa-solid fa-right-to-bracket me-2" style="color:#0D7055;"></i>Check-In hôm nay (@Model.Data.CheckIngToday.Count)</h5>
            </div>
            <div class="admin-card-body p-0">
                @if (!Model.Data.CheckIngToday.Any())
                {
                    <div class="text-center py-4" style="color:var(--text-sub);">
                        <i class="fa-solid fa-inbox fa-2x mb-2 d-block" style="color:#BBF7D0;"></i>
                        Không có khách check-in hôm nay
                    </div>
                }
                else
                {
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Khách hàng</th>
                                <th>Phòng</th>
                                <th>Check-Out</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Data.CheckIngToday)
                            {
                                <tr>
                                    <td><span style="font-weight:700;color:var(--primary);">#@b.Id</span></td>
                                    <td>
                                        <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                        <div style="font-size:.73rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                                    </td>
                                    <td>
                                        @foreach (var br in b.BookingRooms)
                                        {
                                            <span class="status-badge badge-available">@br.Room?.RoomNumber</span>
                                        }
                                    </td>
                                    <td>@b.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id"
                                           class="btn-admin-sm btn-view">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── QUICK ACTIONS ── -->
<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="fa-solid fa-bolt me-2" style="color:#FBBF24;"></i>Thao tác nhanh</h5>
            </div>
            <div class="admin-card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <a asp-page="/Manager/Bookings/Index" class="d-block text-center p-3 rounded-3 text-decoration-none"
                           style="background:#ECFDF5;border:1.5px dashed #6EE7B7;transition:all .2s;"
                           onmouseover="this.style.background='#D1FAE5'" onmouseout="this.style.background='#ECFDF5'">
                            <i class="fa-solid fa-calendar-check fa-2x mb-2 d-block" style="color:#0D7055;"></i>
                            <span style="font-size:.85rem;font-weight:600;color:#0D7055;">Tất cả booking</span>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-page="/Manager/Rooms/Index" class="d-block text-center p-3 rounded-3 text-decoration-none"
                           style="background:#FFF7ED;border:1.5px dashed #FCD34D;transition:all .2s;"
                           onmouseover="this.style.background='#FEF3C7'" onmouseout="this.style.background='#FFF7ED'">
                            <i class="fa-solid fa-bed fa-2x mb-2 d-block" style="color:#C2410C;"></i>
                            <span style="font-size:.85rem;font-weight:600;color:#C2410C;">Quản lý phòng</span>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-page="/Manager/Rooms/Create" class="d-block text-center p-3 rounded-3 text-decoration-none"
                           style="background:#EFF4FF;border:1.5px dashed #93C5FD;transition:all .2s;"
                           onmouseover="this.style.background='#DBEAFE'" onmouseout="this.style.background='#EFF4FF'">
                            <i class="fa-solid fa-plus-circle fa-2x mb-2 d-block" style="color:#1565C0;"></i>
                            <span style="font-size:.85rem;font-weight:600;color:#1565C0;">Thêm phòng mới</span>
                        </a>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-page="/Manager/Bookings/Index" asp-route-status="1" class="d-block text-center p-3 rounded-3 text-decoration-none"
                           style="background:#FEF2F2;border:1.5px dashed #FCA5A5;transition:all .2s;"
                           onmouseover="this.style.background='#FEE2E2'" onmouseout="this.style.background='#FEF2F2'">
                            <i class="fa-solid fa-clock fa-2x mb-2 d-block" style="color:#DC2626;"></i>
                            <span style="font-size:.85rem;font-weight:600;color:#DC2626;">Chờ xác nhận (@Model.Data.PendingCount)</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
