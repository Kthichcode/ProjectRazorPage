@page
@model HotelManagementRazorPage.Pages.Manager.Bookings.IndexModel
@{
    ViewData["Title"] = "Quản lý đặt phòng";
    Layout = "/Pages/Manager/_ManagerLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="page-title">Quản lý đặt phòng</div>
        <div class="page-sub">Tra cứu, xác nhận và cập nhật trạng thái đặt phòng</div>
    </div>
</div>

<!-- FILTER -->
<div class="mgr-card mb-3">
    <div style="padding:1.2rem 1.4rem;">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="admin-form-label">Ngày nhận phòng</label>
                    <input type="date" name="date" value="@(Model.FilterDate?.ToString("yyyy-MM-dd"))" class="admin-form-control" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="admin-form-label">Trạng thái</label>
                    <select name="status" class="admin-form-control">
                        <option value="">— Tất cả —</option>
                        <option value="1" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.Pending)">Chờ xác nhận</option>
                        <option value="2" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.Confirmed)">Đã xác nhận</option>
                        <option value="3" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.CheckedIn)">Đang ở</option>
                        <option value="4" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.Completed)">Hoàn thành</option>
                        <option value="5" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.Cancelled)">Đã hủy</option>
                        <option value="6" selected="@(Model.FilterStatus == BusinessObjects.Enums.BookingStatus.CancellationPending)">Chờ duyệt hoàn tiền</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="admin-form-label">Số điện thoại khách</label>
                    <input type="text" name="phone" value="@Model.FilterPhone" class="admin-form-control" placeholder="VD: 0912..." />
                </div>
                <div class="col-sm-6 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn-mgr-primary flex-grow-1">
                        <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                    </button>
                    <a asp-page="/Manager/Bookings/Index"
                       style="display:flex;align-items:center;justify-content:center;width:40px;height:40px;background:var(--bg-alt);border:1px solid var(--divider);border-radius:8px;color:var(--text-sub);text-decoration:none;transition:all .2s;"
                       onmouseover="this.style.background='var(--divider)'" onmouseout="this.style.background='var(--bg-alt)'">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mgr-alert mgr-alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mgr-alert mgr-alert-danger"><i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]</div>
}

<!-- TABLE -->
<div class="mgr-card">
    <div class="mgr-card-header">
        <h5><i class="fa-solid fa-list me-2"></i>Danh sách đặt phòng <span style="color:var(--text-sub);font-weight:400;">(@Model.Bookings.Count kết quả)</span></h5>
    </div>
    <div style="overflow-x:auto;">
        <table class="mgr-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Khách hàng</th>
                    <th>Ngày nhận</th>
                    <th>Ngày trả</th>
                    <th>Phòng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Bookings.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color:var(--text-sub);">
                            <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block" style="color:var(--divider);"></i>
                            Không có kết quả phù hợp
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td><span style="font-weight:700;color:var(--blue);">#@b.Id</span></td>
                            <td>
                                <div style="font-weight:600;">@(b.Customer?.UserName ?? "—")</div>
                                <div style="font-size:.75rem;color:var(--text-sub);">@(b.Customer?.PhoneNumber ?? "")</div>
                            </td>
                            <td style="font-size:.82rem;">@b.CheckInDate.ToString("dd/MM/yyyy")</td>
                            <td style="font-size:.82rem;">@b.CheckOutDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var br in b.BookingRooms)
                                    {
                                        <span class="status-badge badge-available">@br.Room?.RoomNumber</span>
                                    }
                                </div>
                            </td>
                            <td style="font-weight:700;color:var(--blue);font-size:.82rem;">@b.TotalAmount.ToString("N0")₫</td>
                            <td>
                                @switch (b.Status)
                                {
                                    case BusinessObjects.Enums.BookingStatus.Pending:
                                        <span class="status-badge badge-pending">Chờ xác nhận</span>
                                        break;
                                    case BusinessObjects.Enums.BookingStatus.Confirmed:
                                        <span class="status-badge badge-confirmed">Đã xác nhận</span>
                                        break;
                                    case BusinessObjects.Enums.BookingStatus.CheckedIn:
                                        <span class="status-badge badge-checkedin">Đang ở</span>
                                        break;
                                    case BusinessObjects.Enums.BookingStatus.Completed:
                                        <span class="status-badge badge-completed">Hoàn thành</span>
                                        break;
                                    case BusinessObjects.Enums.BookingStatus.Cancelled:
                                        <span class="status-badge badge-cancelled">Đã hủy</span>
                                        break;
                                    case BusinessObjects.Enums.BookingStatus.CancellationPending:
                                        <span class="status-badge badge-cancelpending">
                                            <i class="fa-solid fa-rotate-left"></i> Chờ hoàn tiền
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <a asp-page="/Manager/Bookings/Details" asp-route-id="@b.Id" class="btn-mgr-sm btn-view">
                                    <i class="fa-solid fa-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
