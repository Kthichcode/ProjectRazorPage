@page
@model HotelManagementRazorPage.Pages.Manager.ReviewsModel
@{
    ViewData["Title"] = "Quản lý bình luận";
    Layout = "~/Pages/Manager/_ManagerLayout.cshtml";
    var reviews = Model.Tab == "all" ? Model.AllReviews : Model.PendingReviews;
}

@section AdminStyles {
    /* ── TABS ── */
    .review-tabs {
        display: flex;
        gap: 0;
        border-bottom: 1px solid var(--divider);
        margin-bottom: 1.6rem;
    }
    .review-tab {
        display: inline-flex; align-items: center; gap: .45rem;
        padding: .65rem 1.2rem;
        font-size: .845rem; font-weight: 600;
        color: var(--text-sub); text-decoration: none;
        border-bottom: 2.5px solid transparent;
        transition: color .15s, border-color .15s;
    }
    .review-tab:hover { color: var(--text); }
    .review-tab.active { color: var(--blue); border-bottom-color: var(--blue); }

    .tab-count {
        min-width: 18px; height: 18px; padding: 0 5px;
        border-radius: 9px; background: #FF3B30; color: #fff;
        font-size: .6rem; font-weight: 700;
        display: inline-flex; align-items: center; justify-content: center;
    }

    /* ── REVIEW CARD ── */
    .rev-card {
        background: var(--bg);
        border: 1px solid var(--divider);
        border-radius: 14px;
        padding: 1.3rem 1.4rem;
        transition: box-shadow .2s;
    }
    .rev-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.07); }

    .rev-avatar {
        width: 38px; height: 38px;
        border-radius: 9px;
        background: var(--blue);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem;
        flex-shrink: 0;
    }

    .rev-name { font-weight: 700; font-size: .9rem; color: var(--text); }
    .rev-meta { font-size: .75rem; color: var(--text-sub); }

    .rev-room-badge {
        display: inline-flex; align-items: center;
        padding: .2rem .65rem; border-radius: 980px;
        background: var(--blue-dim); color: var(--blue);
        font-size: .67rem; font-weight: 700;
    }
    .rev-status-badge {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .2rem .65rem; border-radius: 980px;
        font-size: .67rem; font-weight: 700;
    }
    .rev-approved  { background: #DCFCE7; color: #166534; }
    .rev-rejected  { background: #FEE2E2; color: #991B1B; }
    .rev-pending   { background: #FEF3C7; color: #92400E; }

    .rev-stars { display: flex; gap: 2px; align-items: center; }
    .rev-stars i { font-size: .82rem; }
    .rev-stars .filled { color: #F59E0B; }
    .rev-stars .empty  { color: var(--divider); }

    .rev-comment { font-size: .88rem; color: #475569; line-height: 1.6; }

    /* Action buttons */
    .btn-rev-approve {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .38rem 1rem; border-radius: 8px; border: none;
        background: var(--blue-dim); color: var(--blue);
        font-size: .8rem; font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .btn-rev-approve:hover { background: var(--blue); color: #fff; }

    .btn-rev-reject {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .38rem 1rem; border-radius: 8px;
        border: 1px solid var(--divider);
        background: none; color: var(--text-sub);
        font-size: .8rem; font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .btn-rev-reject:hover { border-color: #DC2626; color: #DC2626; background: #FEF2F2; }

    .btn-rev-toggle {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .35rem .9rem; border-radius: 8px; border: 1px solid var(--divider);
        background: var(--bg-alt); color: var(--text-sub);
        font-size: .78rem; font-weight: 500; cursor: pointer; transition: all .2s;
    }
    .btn-rev-toggle:hover { background: var(--divider); color: var(--text); }

    /* empty */
    .empty-reviews { text-align:center; padding:4rem 1rem; color:var(--text-sub); }
    .empty-reviews i { font-size:2.5rem; color:var(--divider); display:block; margin-bottom:.9rem; }
}

<!-- PAGE HEADER -->
<div class="mb-4">
    <div class="page-title">Duyệt bình luận</div>
    <div class="page-sub">Kiểm duyệt và phê duyệt đánh giá của khách hàng</div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mgr-alert mgr-alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
}

<!-- TABS -->
<div class="review-tabs">
    <a class="review-tab @(Model.Tab == "pending" ? "active" : "")"
       asp-page="/Manager/Reviews" asp-route-tab="pending">
        <i class="fa-solid fa-clock"></i> Chờ duyệt
        @if (Model.PendingReviews.Any())
        {
            <span class="tab-count">@Model.PendingReviews.Count</span>
        }
    </a>
    <a class="review-tab @(Model.Tab == "all" ? "active" : "")"
       asp-page="/Manager/Reviews" asp-route-tab="all">
        <i class="fa-solid fa-list"></i> Tất cả (@Model.AllReviews.Count)
    </a>
</div>

@if (!reviews.Any())
{
    <div class="empty-reviews">
        <i class="fa-regular fa-comment-dots"></i>
        <p>@(Model.Tab == "pending" ? "Không có bình luận nào chờ duyệt." : "Chưa có bình luận nào.")</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in reviews)
        {
            var reviewer = r.Booking?.Customer?.FullName ?? r.Booking?.Customer?.UserName ?? "Khách hàng";
            var roomNum  = r.Room?.RoomNumber ?? "?";
            var initials = reviewer.Length > 0 ? reviewer[0].ToString().ToUpper() : "K";
            string statusCls  = r.IsApproved == true ? "rev-approved" : r.IsApproved == false ? "rev-rejected" : "rev-pending";
            string statusText = r.IsApproved == true ? "Đã duyệt"   : r.IsApproved == false ? "Đã từ chối"  : "Chờ duyệt";

            <div class="rev-card">
                <div class="d-flex align-items-start gap-3">
                    <div class="rev-avatar">@initials</div>
                    <div class="flex-grow-1 min-width-0">
                        <!-- Header row -->
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="rev-name">@reviewer</span>
                            <span class="rev-room-badge"><i class="fa-solid fa-bed me-1" style="font-size:.6rem;"></i>Phòng @roomNum</span>
                            <span class="rev-status-badge @statusCls">@statusText</span>
                            <span class="ms-auto rev-meta">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <!-- Stars -->
                        <div class="rev-stars mb-2">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <i class="fa-solid fa-star @(s <= r.Rating ? "filled" : "empty")"></i>
                            }
                            <span class="rev-meta ms-2">@r.Rating / 5</span>
                        </div>
                        <!-- Comment -->
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <p class="rev-comment mb-2">@r.Comment</p>
                        }
                        <!-- Actions -->
                        @if (r.IsApproved == null)
                        {
                            <div class="d-flex gap-2">
                                <form method="post" asp-page-handler="Approve" asp-route-tab="@Model.Tab" class="m-0">
                                    <input type="hidden" name="reviewId" value="@r.Id" />
                                    <button class="btn-rev-approve"><i class="fa-solid fa-check"></i> Duyệt</button>
                                </form>
                                <form method="post" asp-page-handler="Reject" asp-route-tab="@Model.Tab" class="m-0">
                                    <input type="hidden" name="reviewId" value="@r.Id" />
                                    <button class="btn-rev-reject"><i class="fa-solid fa-xmark"></i> Từ chối</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="@(r.IsApproved == true ? "Reject" : "Approve")" asp-route-tab="@Model.Tab" class="m-0 d-inline">
                                <input type="hidden" name="reviewId" value="@r.Id" />
                                <button class="btn-rev-toggle">
                                    @(r.IsApproved == true ? "↩ Huỷ duyệt" : "↩ Duyệt lại")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
