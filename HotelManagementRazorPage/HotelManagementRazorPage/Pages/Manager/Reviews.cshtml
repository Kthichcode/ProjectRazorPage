@page
@model HotelManagementRazorPage.Pages.Manager.ReviewsModel
@{
    ViewData["Title"] = "Quản lý bình luận";
    Layout = "~/Pages/Manager/_ManagerLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible d-flex gap-2 align-items-center">
        <i class="fa-solid fa-circle-check"></i><div>@TempData["Success"]</div>
        <button class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" style="border-bottom-color:#E2EAF4;">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "pending" ? "active fw-bold" : "text-muted")"
           asp-page="/Manager/Reviews" asp-route-tab="pending">
            <i class="fa-solid fa-clock me-1"></i>Chờ duyệt
            @if (Model.PendingReviews.Any()) {
                <span class="badge bg-danger ms-1">@Model.PendingReviews.Count</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "all" ? "active fw-bold" : "text-muted")"
           asp-page="/Manager/Reviews" asp-route-tab="all">
            <i class="fa-solid fa-list me-1"></i>Tất cả (@Model.AllReviews.Count)
        </a>
    </li>
</ul>

@{
    var reviews = Model.Tab == "all" ? Model.AllReviews : Model.PendingReviews;
}

@if (!reviews.Any())
{
    <div class="text-center py-5" style="color:#94A3B8;">
        <i class="fa-regular fa-comment-dots fa-3x mb-3" style="display:block;"></i>
        <p>@(Model.Tab == "pending" ? "Không có bình luận nào chờ duyệt." : "Chưa có bình luận nào.")</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in reviews)
        {
            var reviewer = r.Booking?.Customer?.FullName ?? r.Booking?.Customer?.UserName ?? "Khách hàng";
            var roomNum = r.Room?.RoomNumber ?? "?";
            var initials = reviewer.Length > 0 ? reviewer[0].ToString().ToUpper() : "K";
            string statusBadge = r.IsApproved == true ? "bg-success" : r.IsApproved == false ? "bg-danger" : "bg-warning text-dark";
            string statusText = r.IsApproved == true ? "Đã duyệt" : r.IsApproved == false ? "Đã từ chối" : "Chờ duyệt";

            <div class="rev-card">
                <div class="d-flex align-items-start gap-3">
                    <div class="rev-avatar">@initials</div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span style="font-weight:700;font-size:.92rem;">@reviewer</span>
                            <span class="badge" style="font-size:.65rem;background:#EFF4FF;color:#1565C0;">Phòng @roomNum</span>
                            <span class="badge @statusBadge" style="font-size:.65rem;">@statusText</span>
                            <span class="ms-auto" style="font-size:.75rem;color:#94A3B8;">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <!-- Stars -->
                        <div style="font-size:.85rem;margin-bottom:.5rem;">
                            @for (int s = 1; s <= 5; s++) {
                                <i class="fa-solid fa-star @(s <= r.Rating ? "text-warning" : "text-muted opacity-25")"></i>
                            }
                            <span style="font-size:.75rem;color:#64748B;margin-left:.3rem;">(@r.Rating/5)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <p style="font-size:.88rem;color:#475569;line-height:1.6;margin-bottom:.75rem;">@r.Comment</p>
                        }

                        @if (r.IsApproved == null)
                        {
                            <div class="d-flex gap-2">
                                <form method="post" asp-page-handler="Approve" asp-route-tab="@Model.Tab" class="m-0">
                                    <input type="hidden" name="reviewId" value="@r.Id" />
                                    <button class="btn btn-success btn-sm fw-bold px-3">
                                        <i class="fa-solid fa-check me-1"></i>Duyệt
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" asp-route-tab="@Model.Tab" class="m-0">
                                    <input type="hidden" name="reviewId" value="@r.Id" />
                                    <button class="btn btn-outline-danger btn-sm fw-bold px-3">
                                        <i class="fa-solid fa-xmark me-1"></i>Từ chối
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="@(r.IsApproved == true ? "Reject" : "Approve")" asp-route-tab="@Model.Tab" class="m-0 d-inline">
                                <input type="hidden" name="reviewId" value="@r.Id" />
                                <button class="btn btn-outline-secondary btn-sm" style="font-size:.78rem;">
                                    @(r.IsApproved == true ? "↩ Huỷ duyệt" : "↩ Duyệt lại")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .rev-card { background:#fff;border:1px solid #E2EAF4;border-radius:14px;padding:1.25rem 1.4rem;box-shadow:0 2px 10px rgba(21,101,192,.05); }
    .rev-avatar { width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#1565C0,#42A5F5);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;flex-shrink:0; }
    .nav-tabs .nav-link { border:none;border-bottom:2.5px solid transparent;border-radius:0;padding:.5rem 1rem; }
    .nav-tabs .nav-link.active { border-bottom-color:#1565C0;color:#1565C0;background:none; }
</style>
